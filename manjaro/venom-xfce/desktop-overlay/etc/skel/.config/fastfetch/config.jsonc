{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii-art",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "key": "VENOM",
      "keyColor": "bright_white"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "bright_black"
    },
    {
      "type": "host",
      "key": "MACHINE",
      "keyColor": "bright_black"
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      "keyColor": "bright_black"
    },
    {
      "type": "uptime",
      "key": "UPTIME",
      "keyColor": "bright_black"
    },
    {
      "type": "packages",
      "key": "PACKAGES",
      "keyColor": "bright_black"
    },
    "break",
    {
      "type": "de",
      "key": "DESKTOP",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "WINDOWS",
      "keyColor": "white"
    },
    {
      "type": "theme",
      "key": "THEME",
      "keyColor": "white"
    },
    {
      "type": "icons",
      "key": "ICONS",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "TERMINAL",
      "keyColor": "white"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "bright_white"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "bright_white"
    },
    {
      "type": "memory",
      "key": "MEMORY",
      "keyColor": "bright_white"
    },
    {
      "type": "disk",
      "key": "DISK",
      "keyColor": "bright_white"
    },
    "break"
  ]
}
