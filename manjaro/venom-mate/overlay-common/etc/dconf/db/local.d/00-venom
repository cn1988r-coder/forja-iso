[org/mate/desktop/interface]
gtk-theme='Materia-dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
font-name='Noto Sans 10'
gtk-enable-animations=false

[org/mate/desktop/background]
picture-filename='/usr/share/backgrounds/venom/venom-wallpaper.svg'
picture-options='zoom'
color-shading-type='solid'
primary-color='#05080d'
secondary-color='#05080d'

[org/mate/marco/general]
theme='Materia-dark'
button-layout=':minimize,maximize,close'

[org/mate/panel]
default-layout='venom'

[org/mate/panel/toplevels/bottom]
orientation='bottom'
expand=true
size=48
auto-hide=false
background-type='color'
background-color='#080d15'
background-opacity=96

[org/mate/panel/objects/venom-window-list]
group-windows='always'
