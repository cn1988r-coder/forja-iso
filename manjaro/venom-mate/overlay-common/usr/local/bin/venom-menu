#!/usr/bin/env python3
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk
CSS = b"""
window { background: #080c12; color: #eaf2fb; }
entry { background: #101c2a; color: #f4f8ff; border: 1px solid #164c78; border-radius: 7px; padding: 10px; }
button { background: #111d2c; color: #eaf2fb; border: 1px solid #1b4568; border-radius: 7px; padding: 8px; }
button:hover { background: #10385b; border-color: #168cff; }
"""
provider = Gtk.CssProvider()
provider.load_from_data(CSS)
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
class Menu(Gtk.Window):
    def __init__(self):
        super().__init__(title="VENOM OS")
        self.set_default_size(520, 600)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(18)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(root)
        title = Gtk.Label()
        title.set_markup('<span foreground="#168cff" weight="bold" size="32000">V  VENOM OS</span>')
        title.set_xalign(0)
        root.pack_start(title, False, False, 8)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Buscar aplicativo...")
        self.search.connect("search-changed", self.filter)
        root.pack_start(self.search, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        root.pack_start(scroll, True, True, 0)
        self.rows = Gtk.ListBox()
        self.rows.set_selection_mode(Gtk.SelectionMode.NONE)
        scroll.add(self.rows)
        self.entries = []
        apps = sorted(Gtk.AppInfo.get_all(), key=lambda a: (a.get_display_name() or "").casefold())
        for app in apps:
            if not app.should_show():
                continue
            row = Gtk.ListBoxRow()
            line = Gtk.Box(spacing=12)
            line.set_border_width(8)
            icon = app.get_icon()
            image = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.DIALOG) if icon else Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
            line.pack_start(image, False, False, 0)
            label = Gtk.Label(label=app.get_display_name() or app.get_id())
            label.set_xalign(0)
            line.pack_start(label, True, True, 0)
            launch = Gtk.Button(label="ABRIR")
            launch.connect("clicked", lambda _button, item=app: self.start_app(item))
            line.pack_end(launch, False, False, 0)
            row.add(line)
            self.rows.add(row)
            self.entries.append((row, (app.get_display_name() or "").casefold()))
        self.show_all()
        self.search.grab_focus()
    def filter(self, _entry):
        query = self.search.get_text().casefold().strip()
        for row, name in self.entries:
            row.set_visible(not query or query in name)
    def start_app(self, app):
        app.launch([], None)
        self.destroy()
window = Menu()
window.connect("destroy", Gtk.main_quit)
window.connect("key-press-event", lambda _window, event: (window.destroy(), True) if event.keyval == Gdk.KEY_Escape else False)
Gtk.main()
