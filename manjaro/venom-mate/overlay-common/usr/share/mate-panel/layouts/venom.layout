[Toplevel top]
expand=true
orientation=top
size=34

[Toplevel bottom]
expand=true
orientation=bottom
size=48

[Object venom-brisk-menu]
object-type=applet
applet-iid=BriskMenuFactory::BriskMenu
toplevel-id=top
pack-index=0
locked=true

[Object venom-pamac-launcher]
object-type=launcher
toplevel-id=top
launcher-location=/usr/share/applications/venom-pamac.desktop
pack-type=center
pack-index=0
locked=true

[Object venom-top-notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=top
pack-type=end
pack-index=2
locked=true

[Object venom-top-volume]
object-type=applet
applet-iid=GvcAppletFactory::GvcApplet
toplevel-id=top
pack-type=end
pack-index=1
locked=true

[Object venom-top-clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=top
pack-type=end
pack-index=0
locked=true

[Object venom-show-desktop]
object-type=applet
applet-iid=WnckletFactory::ShowDesktopApplet
toplevel-id=bottom
pack-index=0
locked=true

[Object venom-window-list]
object-type=applet
applet-iid=WnckletFactory::WindowListApplet
toplevel-id=bottom
pack-index=1
locked=true

[Object venom-workspace-switcher]
object-type=applet
applet-iid=WnckletFactory::WorkspaceSwitcherApplet
toplevel-id=bottom
pack-type=end
pack-index=0
locked=true
