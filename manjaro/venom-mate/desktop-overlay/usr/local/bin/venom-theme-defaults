#!/usr/bin/env bash
# Aplica somente os três temas padrão da VENOM OS MATE.
# Não altera painel, layout, wallpaper, serviços ou aplicativos.
set -Eeuo pipefail

log() { printf '[VENOM temas] %s\n' "$*"; }
warn() { printf '[VENOM temas] AVISO: %s\n' "$*" >&2; }

[[ "$EUID" -ne 0 ]] || exit 0
command -v gsettings >/dev/null 2>&1 || exit 0

icons_dir="$HOME/.local/share/icons"
theme_dir="$icons_dir/Bibata-Modern-Classic"
marker="$HOME/.config/venom-theme-defaults.done"
[[ -e "$marker" ]] && exit 0

if [[ ! -s "$theme_dir/index.theme" ]]; then
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT
    archive="$tmp_dir/Bibata-Modern-Classic.tar.xz"
    url="https://github.com/ful1e5/Bibata_Cursor/releases/download/v2.0.7/Bibata-Modern-Classic.tar.xz"

    log "Instalando Bibata Modern Classic."
    if curl --fail --location --retry 3 --connect-timeout 15 "$url" --output "$archive" &&
       tar -xJf "$archive" -C "$tmp_dir"; then
        source_dir=""
        while IFS= read -r candidate; do
            if [[ "$(basename "$candidate")" == "Bibata-Modern-Classic" ]]; then
                source_dir="$(dirname "$candidate")"
                break
            fi
        done < <(find "$tmp_dir" -type f -name index.theme -print)

        if [[ -n "$source_dir" && -s "$source_dir/index.theme" ]]; then
            mkdir -p "$icons_dir"
            cp -a "$source_dir" "$theme_dir"
        else
            warn "O arquivo Bibata esperado não foi encontrado no pacote."
            exit 0
        fi
    else
        warn "Não foi possível baixar ou extrair Bibata; a configuração será tentada no próximo login."
        exit 0
    fi
fi

set_setting() {
    local schema="$1" key="$2" value="$3"
    if gsettings list-schemas | grep -Fxq "$schema"; then
        gsettings set "$schema" "$key" "$value" || warn "Falha em $schema.$key"
    else
        warn "Schema indisponível: $schema"
    fi
}

set_setting org.mate.interface gtk-theme "'Materia-dark'"
set_setting org.mate.Marco.general theme "'Materia-dark'"
set_setting org.mate.interface icon-theme "'Papirus-Dark'"
set_setting org.mate.peripherals-mouse cursor-theme "'Bibata-Modern-Classic'"
set_setting org.mate.peripherals-mouse cursor-size "24"
set_setting org.mate.interface gtk-application-prefer-dark-theme "true"

mkdir -p "$HOME/.config"
touch "$marker"
log "Padrões aplicados: Materia-dark, Papirus-Dark e Bibata-Modern-Classic."
