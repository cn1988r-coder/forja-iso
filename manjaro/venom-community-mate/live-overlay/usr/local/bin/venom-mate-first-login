#!/bin/sh
set -eu
marker="$HOME/.config/venom-mate-first-login.done"
[ -e "$marker" ] && exit 0
mkdir -p "$HOME/.config"
gsettings set org.mate.interface gtk-theme 'Adwaita-dark' || true
gsettings set org.mate.interface icon-theme 'Papirus-Dark' || true
gsettings set org.mate.interface cursor-theme 'Bibata-Modern-Classic' || true
gsettings set org.mate.Marco.general theme 'Adwaita' || true
gsettings set org.mate.desktop.background picture-filename '/usr/share/backgrounds/venom/venom-black.svg' || true
touch "$marker"
