#!/usr/bin/python3
"""Narrow privileged transaction helper for Forja Store on Arch Linux."""
import re
import subprocess
import sys

PACKAGE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._+:-]*$")
FLATPAK_ID = re.compile(r"^[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)+$")
ACTIONS = {
    "install", "remove", "upgrade", "flatpak-install-system",
    "flatpak-remove-system", "flatpak-update-system", "forja-install", "forja-sync",
}


def call(args):
    return subprocess.call(args)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if not argv or argv[0] not in ACTIONS:
        print("Ação inválida.", file=sys.stderr)
        return 2

    action, args = argv[0], argv[1:]
    if action in {"install", "remove"}:
        if not args or any(not PACKAGE.fullmatch(name) for name in args):
            print("Nome de pacote inválido.", file=sys.stderr)
            return 2
        if action == "install":
            return call(["/usr/bin/pacman", "-S", "--needed", "--noconfirm", "--", *args])
        return call(["/usr/bin/pacman", "-Rns", "--noconfirm", "--", *args])

    if action == "forja-sync":
        if args:
            return 2
        config = "/etc/forja/pacman.conf"
        return call(["/usr/bin/pacman", "--config", config, "-Sy", "--noconfirm"])

    if action == "forja-install":
        if len(args) != 1 or not PACKAGE.fullmatch(args[0]):
            print("Nome de pacote Forja inválido.", file=sys.stderr)
            return 2
        config = "/etc/forja/pacman-install.conf"
        synced = call(["/usr/bin/pacman", "--config", config, "-Sy", "--noconfirm"])
        if synced != 0:
            return synced
        return call(["/usr/bin/pacman", "--config", config, "-S",
                     "--needed", "--noconfirm", "forja/" + args[0]])

    if action == "upgrade":
        if args:
            print("A atualização não aceita argumentos.", file=sys.stderr)
            return 2
        return call(["/usr/bin/pacman", "-Syu", "--noconfirm"])

    if action.startswith("flatpak-"):
        if action == "flatpak-update-system":
            if args:
                return 2
            return call(["/usr/bin/flatpak", "update", "--system",
                         "--noninteractive", "--assumeyes"])
        if len(args) != 1 or not FLATPAK_ID.fullmatch(args[0]):
            print("ID Flatpak inválido.", file=sys.stderr)
            return 2
        app_id = args[0]
        if action == "flatpak-install-system":
            remote = call(["/usr/bin/flatpak", "remote-add", "--if-not-exists",
                           "--system", "flathub",
                           "https://flathub.org/repo/flathub.flatpakrepo"])
            if remote != 0:
                return remote
            return call(["/usr/bin/flatpak", "install", "--system",
                         "--noninteractive", "--assumeyes", "flathub", app_id])
        if action == "flatpak-remove-system":
            return call(["/usr/bin/flatpak", "uninstall", "--system",
                         "--noninteractive", "--assumeyes", app_id])

    return 2


if __name__ == "__main__":
    raise SystemExit(main())
