pkgname=forja-store
pkgver=0.2.0
pkgrel=1
pkgdesc="Central gráfica de aplicativos da Forja OS para Arch Linux"
arch=('any')
url="https://github.com/cn1988r-coder/forja-iso"
license=('GPL-3.0-or-later')
depends=('python' 'pacman' 'pacman-contrib' 'gtk3' 'python-gobject' 'polkit')
optdepends=('flatpak: consultar e atualizar aplicativos Flatpak'
            'git: baixar fontes do AUR'
            'base-devel: compilar pacotes do AUR'
            'less: visualizar arquivos de compilação')
backup=()
source=()
sha256sums=()

package() {
  install -Dm755 "$startdir/forja-store.py" "$pkgdir/usr/lib/forja/forja-store"
  install -Dm755 "$startdir/forja-pacman-transaction" "$pkgdir/usr/bin/forja-pacman-transaction"
  install -Dm755 "$startdir/forja-aur-build" "$pkgdir/usr/bin/forja-aur-build"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/forja-store" <<'EOF'
#!/usr/bin/env sh
exec /usr/bin/python3 /usr/lib/forja/forja-store "$@"
EOF
  install -Dm644 "$startdir/br.forja.store.policy" "$pkgdir/usr/share/polkit-1/actions/br.forja.store.policy"
  install -Dm644 "$startdir/forja-store.desktop" "$pkgdir/usr/share/applications/forja-store.desktop"
  install -Dm644 "$startdir/forja-store.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/forja-store.svg"
}
