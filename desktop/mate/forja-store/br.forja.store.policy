<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Forja OS</vendor>
  <vendor_url>https://github.com/cn1988r-coder/forja-iso</vendor_url>
  <action id="org.freedesktop.policykit.exec">
    <description>Gerenciar pacotes do sistema com a Forja Store</description>
    <message>Autentique-se para instalar, remover ou atualizar programas.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/forja-pacman-transaction</annotate>
  </action>
</policyconfig>
