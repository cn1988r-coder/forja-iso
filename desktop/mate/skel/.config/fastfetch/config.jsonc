{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/forja.txt",
    "color": {
      "1": "#398BFF",
      "2": "#BFC5CE"
    },
    "padding": {
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 13
    },
    "color": {
      "keys": "#398BFF",
      "title": "#398BFF",
      "output": "#BFC5CE",
      "separator": "#777F8A"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk"
  ]
}
