# Office suite (stable maintenance branch) and Brazilian Portuguese UI
libreoffice-still
libreoffice-still-pt-br

# Standalone GNOME calculator; does not install the GNOME desktop
gnome-calculator

# Screenshot utility: use only the XFCE screenshot application
# This does not install the XFCE desktop, panel, session, or file manager.
xfce4-screenshooter

# Plymouth boot splash and SVG-to-PNG renderer for the Forja branding.
plymouth
librsvg

# Calamares, Brisk Menu and Bibata cursor are built into the local Forja repository.
calamares
brisk-menu
bibata-cursor-theme-bin

