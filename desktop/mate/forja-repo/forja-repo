#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG="/etc/forja/pacman.conf"
if [[ ! -r "$CONFIG" ]]; then
  echo "Configuração do repositório Forja não encontrada: $CONFIG" >&2
  exit 1
fi
command -v pacman >/dev/null 2>&1 || { echo "pacman não encontrado." >&2; exit 1; }
command -v vercmp >/dev/null 2>&1 || { echo "vercmp não encontrado (pacman-contrib)." >&2; exit 1; }

usage() {
  echo "Uso: forja-repo {list|search TERMO|updates|check}" >&2
}

sync_repo() {
  command -v pkexec >/dev/null 2>&1 || { echo "pkexec não encontrado." >&2; return 1; }
  pkexec /usr/bin/forja-pacman-transaction forja-sync
}

case "${1:-}" in
  list)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    sync_repo
    pacman --config "$CONFIG" -Sl forja
    ;;
  search)
    [[ "$#" -eq 2 && -n "$2" ]] || { usage; exit 2; }
    sync_repo
    pacman --config "$CONFIG" -Ss "$2" | awk '$1 ~ /^forja\// {print; getline; print}'
    ;;
  updates|check)
    [[ "$#" -eq 1 ]] || { usage; exit 2; }
    sync_repo
    mapfile -t rows < <(pacman --config "$CONFIG" -Sl forja)
    updates=0
    for row in "${rows[@]}"; do
      read -r _repo pkg remote_version _rest <<< "$row"
      [[ -n "${pkg:-}" && -n "${remote_version:-}" ]] || continue
      local_line="$(pacman -Q "$pkg" 2>/dev/null || true)"
      [[ -n "$local_line" ]] || continue
      local_version="${local_line#* }"
      if [[ "$(vercmp "$remote_version" "$local_version")" -gt 0 ]]; then
        printf 'Atualização Forja disponível: %s %s -> %s\n' "$pkg" "$local_version" "$remote_version"
        updates=$((updates + 1))
      fi
    done
    if (( updates == 0 )); then
      echo "Nenhuma atualização Forja disponível."
    else
      printf '\n%d atualização(ões) Forja disponível(is).\n' "$updates"
    fi
    echo "A consulta usa banco e cache isolados; não atualiza pacotes do Arch."
    ;;
  *)
    usage
    exit 2
    ;;
esac
