#!/usr/bin/python3
"""Privileged APT transaction helper. Invoke through pkexec."""
import re
import subprocess
import sys

PACKAGE_RE = re.compile(r"^[a-z0-9][a-z0-9+.-]*(:[a-z0-9-]+)?$")


def run(args):
    return subprocess.call(args, env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"})


def main():
    if len(sys.argv) < 2:
        return 2
    action = sys.argv[1]
    if action == "refresh" and len(sys.argv) == 2:
        return run(["/usr/bin/apt-get", "update"])
    if action == "upgrade" and len(sys.argv) == 2:
        return run(["/usr/bin/apt-get", "upgrade", "-y"])
    if action in ("install", "remove") and len(sys.argv) >= 3:
        packages = sys.argv[2:]
        if not all(PACKAGE_RE.fullmatch(p) for p in packages):
            print("Nome de pacote inválido.", file=sys.stderr)
            return 2
        command = "install" if action == "install" else "remove"
        return run(["/usr/bin/apt-get", command, "-y", "--", *packages])
    print("Operação não permitida.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
