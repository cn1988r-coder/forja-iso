#!/usr/bin/python3
"""Forja Software: Pamac-inspired GTK4 frontend for Ubuntu APT and Flatpak."""
import subprocess
import threading

import apt
import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, GLib

HELPER = "/usr/lib/forja/forja-apt-transaction"
FLATPAK = "/usr/bin/flatpak"


def command(args):
    try:
        result = subprocess.run(args, check=False, text=True, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, timeout=90)
        if result.returncode == 0:
            return result.stdout.splitlines(), None
        return [], result.stderr.strip() or f"Comando terminou com código {result.returncode}"
    except FileNotFoundError:
        return [], "Flatpak não está instalado."
    except subprocess.TimeoutExpired:
        return [], "A consulta demorou demais e foi interrompida."


class ForjaStore(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="br.forja.Software")
        self.window = None
        self.rows = None
        self.search = None
        self.status = None
        self.source_filter = None
        self.mode = "all"
        self.source = "all"
        self.items = []
        self.busy = False

    def do_activate(self):
        if self.window:
            self.window.present()
            return
        self.window = Gtk.ApplicationWindow(application=self, title="Forja Software")
        self.window.set_default_size(1040, 680)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        header = Gtk.HeaderBar()
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Pesquisar aplicativos e pacotes")
        self.search.set_hexpand(True)
        header.set_title_widget(self.search)
        self.refresh_button = Gtk.Button(label="Atualizar bancos")
        self.refresh_button.connect("clicked", self.refresh_all)
        header.pack_end(self.refresh_button)
        self.upgrade_button = Gtk.Button(label="Atualizar tudo")
        self.upgrade_button.connect("clicked", self.update_all)
        self.upgrade_button.set_visible(False)
        header.pack_end(self.upgrade_button)
        self.window.set_titlebar(header)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        sidebar = Gtk.ListBox()
        sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
        sidebar.set_size_request(190, -1)
        for label, mode in (("Todos os programas", "all"), ("Instalados", "installed"),
                            ("Atualizações", "updates")):
            row = Gtk.ListBoxRow()
            row.set_child(Gtk.Label(label=label, xalign=0, margin_start=16,
                                    margin_top=13, margin_bottom=13))
            row.mode = mode
            sidebar.append(row)
        sidebar.connect("row-selected", self.change_mode)
        body.append(sidebar)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        content.set_margin_top(12)
        content.set_margin_start(14)
        content.set_margin_end(14)
        self.source_filter = Gtk.DropDown.new_from_strings(
            ["Todas as fontes", "Ubuntu (APT)", "Flatpak"])
        self.source_filter.connect("notify::selected", self.change_source)
        content.append(self.source_filter)
        scroller = Gtk.ScrolledWindow()
        scroller.set_hexpand(True)
        scroller.set_vexpand(True)
        self.rows = Gtk.ListBox()
        self.rows.set_selection_mode(Gtk.SelectionMode.NONE)
        scroller.set_child(self.rows)
        content.append(scroller)
        body.append(content)
        root.append(body)

        self.status = Gtk.Label(label="Carregando catálogos APT e Flatpak…", xalign=0)
        self.status.set_margin_start(14)
        self.status.set_margin_end(14)
        self.status.set_margin_top(8)
        self.status.set_margin_bottom(8)
        root.append(self.status)
        self.window.set_child(root)
        self.search.connect("search-changed", lambda *_: self.populate())
        self.window.present()
        self.reload_catalogues()

    def change_mode(self, _list, row):
        if row:
            self.mode = row.mode
            self.upgrade_button.set_visible(self.mode == "updates")
            self.populate()

    def change_source(self, *_):
        selected = self.source_filter.get_selected()
        self.source = ("all", "apt", "flatpak")[selected]
        self.populate()

    def reload_catalogues(self):
        if self.busy:
            return
        self.busy = True
        self.status.set_text("Lendo os catálogos de software…")

        def worker():
            items = []
            errors = []
            try:
                cache = apt.Cache()
                for package in cache:
                    candidate = package.candidate
                    if not candidate:
                        continue
                    items.append({
                        "source": "apt", "id": package.name, "name": package.name,
                        "summary": candidate.summary or "Pacote dos repositórios Ubuntu",
                        "installed": package.is_installed,
                        "update": package.is_installed and package.is_upgradable,
                        "remote": None,
                    })
            except Exception as exc:
                errors.append("APT: " + str(exc))

            installed, err = command([FLATPAK, "list", "--system", "--app",
                                      "--columns=application,name,origin"])
            if err and "não está instalado" not in err:
                errors.append("Flatpak instalado: " + err)
            installed_map = {}
            for line in installed:
                cols = line.split("\t")
                if len(cols) >= 1 and cols[0]:
                    installed_map[cols[0]] = {
                        "name": cols[0],
                        "remote": cols[1] if len(cols) > 1 else "",
                    }

            updates, update_err = command([
                FLATPAK, "remote-ls", "--system", "--updates", "--app",
                "--columns=application,origin",
            ])
            update_ids = set()
            if not update_err:
                for line in updates:
                    cols = line.split("\t")
                    if cols and cols[0]:
                        update_ids.add(cols[0])

            remote_apps, remote_err = command([
                FLATPAK, "remote-ls", "--system", "--app",
                "--columns=application,origin",
            ])
            if remote_err and "não está instalado" not in remote_err:
                errors.append("Flatpak: " + remote_err)
            seen = set()
            for line in remote_apps:
                cols = line.split("\t")
                if not cols or not cols[0] or cols[0] in seen:
                    continue
                app_id = cols[0]
                seen.add(app_id)
                name = cols[0]
                description = "Aplicativo Flatpak disponível no repositório configurado."
                remote = cols[1] if len(cols) > 1 else ""
                is_installed = app_id in installed_map
                items.append({
                    "source": "flatpak", "id": app_id, "name": name,
                    "summary": description or "Aplicativo Flatpak",
                    "installed": is_installed,
                    "update": app_id in update_ids,
                    "remote": installed_map.get(app_id, {}).get("remote") or remote,
                })

            GLib.idle_add(self.catalogues_ready, items, errors)

        threading.Thread(target=worker, daemon=True).start()

    def catalogues_ready(self, items, errors):
        self.items = items
        self.busy = False
        apt_count = sum(1 for item in items if item["source"] == "apt")
        flatpak_count = sum(1 for item in items if item["source"] == "flatpak")
        message = f"{apt_count} pacotes APT e {flatpak_count} aplicativos Flatpak."
        if errors:
            message += " Avisos: " + " | ".join(errors)
        self.status.set_text(message)
        self.populate()
        return GLib.SOURCE_REMOVE

    def populate(self):
        if not self.rows:
            return
        while child := self.rows.get_first_child():
            self.rows.remove(child)
        query = self.search.get_text().strip().lower() if self.search else ""
        shown = 0
        for item in self.items:
            if self.source != "all" and item["source"] != self.source:
                continue
            if self.mode == "installed" and not item["installed"]:
                continue
            if self.mode == "updates" and not item["update"]:
                continue
            if query and query not in item["name"].lower() and query not in item["id"].lower() and query not in item["summary"].lower():
                continue
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.set_margin_top(10)
            box.set_margin_bottom(10)
            box.set_margin_start(12)
            box.set_margin_end(12)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            title = Gtk.Label(label=item["name"], xalign=0)
            title.add_css_class("heading")
            info.append(title)
            source_name = "Ubuntu APT" if item["source"] == "apt" else "Flatpak"
            detail = Gtk.Label(label=f"{source_name} • {item['id']}", xalign=0)
            detail.add_css_class("dim-label")
            info.append(detail)
            summary = Gtk.Label(label=item["summary"], xalign=0)
            summary.set_wrap(True)
            summary.add_css_class("dim-label")
            info.append(summary)
            box.append(info)
            if item["update"]:
                label = "Atualizar"
                action = "upgrade-one"
            elif item["installed"]:
                label = "Remover"
                action = "remove"
            else:
                label = "Instalar"
                action = "install"
            button = Gtk.Button(label=label)
            button.connect("clicked", self.transact, action, item)
            box.append(button)
            row.set_child(box)
            self.rows.append(row)
            shown += 1
            if shown >= 500:
                break
        if shown == 0:
            row = Gtk.ListBoxRow()
            row.set_child(Gtk.Label(label="Nenhum resultado para este filtro.", margin_top=24, margin_bottom=24))
            self.rows.append(row)

    def transact(self, _button, action, item):
        if item["source"] == "apt":
            helper_action = "apt-install" if action == "upgrade-one" else "apt-" + action
            args = ["pkexec", HELPER, helper_action, item["id"]]
        else:
            if action == "upgrade-one":
                args = ["pkexec", HELPER, "flatpak-update-app", item["id"]]
            elif action == "install":
                if not item["remote"]:
                    self.status.set_text("Não foi possível identificar o repositório Flatpak deste aplicativo.")
                    return
                args = ["pkexec", HELPER, "flatpak-install", item["remote"], item["id"]]
            else:
                args = ["pkexec", HELPER, "flatpak-remove", item["id"]]
        self.run_transaction(args)

    def run_transaction(self, args):
        if self.busy:
            return
        self.busy = True
        self.status.set_text("Aguardando autorização e executando a operação…")

        def worker():
            result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True)
            output = (result.stdout or "").strip()
            if result.returncode == 0:
                message = "Operação concluída."
            elif result.returncode == 126:
                message = "Operação cancelada na solicitação de autorização."
            else:
                message = f"Falha na operação (código {result.returncode})."
            if output:
                message += " " + output[-700:]
            GLib.idle_add(self.transaction_finished, message, result.returncode == 0)

        threading.Thread(target=worker, daemon=True).start()

    def transaction_finished(self, message, success):
        self.busy = False
        self.status.set_text(message)
        if success:
            self.reload_catalogues()
        return GLib.SOURCE_REMOVE

    def refresh_all(self, *_):
        if self.busy:
            return
        self.busy = True
        self.status.set_text("Atualizando índices Ubuntu e metadados Flatpak…")

        def worker():
            results = []
            for args in (
                ["pkexec", HELPER, "apt-refresh"],
                ["pkexec", HELPER, "flatpak-refresh"],
            ):
                result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True)
                results.append(result.returncode)
            success = all(code == 0 for code in results)
            message = ("Índices atualizados." if success else
                       "Uma ou mais fontes não puderam ser atualizadas. Verifique se Flatpak está instalado e se há remotes configurados.")
            GLib.idle_add(self.transaction_finished, message, success)

        threading.Thread(target=worker, daemon=True).start()

    def update_all(self, *_):
        if self.busy:
            return
        self.busy = True
        self.status.set_text("Instalando atualizações do Ubuntu e do Flatpak…")

        def worker():
            results = []
            for action in ("apt-upgrade", "flatpak-upgrade"):
                result = subprocess.run(["pkexec", HELPER, action],
                                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True)
                results.append(result.returncode)
            success = all(code == 0 for code in results)
            message = ("Atualizações concluídas." if success else
                       "Uma ou mais atualizações falharam ou foram canceladas. Verifique as mensagens do sistema.")
            GLib.idle_add(self.transaction_finished, message, success)

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    raise SystemExit(ForjaStore().run(None))
