#!/usr/bin/python3
"""MATE panel indicator for Ubuntu APT and system Flatpak updates."""
import subprocess
import threading

import apt
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import Gtk, GLib, AyatanaAppIndicator3 as AppIndicator

HELPER = "/usr/lib/forja/forja-apt-transaction"


class UpdateIndicator:
    def __init__(self):
        self.indicator = AppIndicator.Indicator.new(
            "forja-update-indicator", "software-update-available",
            AppIndicator.IndicatorCategory.SYSTEM_SERVICES)
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.menu = Gtk.Menu()
        self.state = Gtk.MenuItem(label="Verificando atualizações…")
        self.state.set_sensitive(False)
        self.menu.append(self.state)
        open_item = Gtk.MenuItem(label="Abrir Forja Software")
        open_item.connect("activate", lambda *_: subprocess.Popen(["forja-store"]))
        self.menu.append(open_item)
        refresh_item = Gtk.MenuItem(label="Procurar atualizações")
        refresh_item.connect("activate", self.refresh)
        self.menu.append(refresh_item)
        apt_item = Gtk.MenuItem(label="Atualizar Ubuntu")
        apt_item.connect("activate", lambda *_: self.run(["pkexec", HELPER, "apt-upgrade"]))
        self.menu.append(apt_item)
        flatpak_item = Gtk.MenuItem(label="Atualizar Flatpak")
        flatpak_item.connect("activate", lambda *_: self.run(["pkexec", HELPER, "flatpak-upgrade"]))
        self.menu.append(flatpak_item)
        self.menu.show_all()
        self.indicator.set_menu(self.menu)
        self.check()
        GLib.timeout_add_seconds(900, self.check)

    def set_state(self, apt_count, flatpak_count, error=None):
        if error:
            label, icon = "Falha ao consultar atualizações", "dialog-error"
        else:
            total = apt_count + flatpak_count
            label = (f"{total} atualização(ões) disponíveis" if total else "Sistema atualizado")
            icon = "software-update-available"
        self.state.set_label(label)
        self.indicator.set_icon_full(icon, label)
        return GLib.SOURCE_REMOVE

    def check(self):
        def worker():
            try:
                cache = apt.Cache()
                apt_count = sum(1 for p in cache if p.is_installed and p.is_upgradable)
                result = subprocess.run([
                    "/usr/bin/flatpak", "remote-ls", "--system", "--updates", "--app",
                    "--columns=application",
                ], check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    timeout=60)
                flatpak_count = len([line for line in result.stdout.splitlines() if line.strip()])
                GLib.idle_add(self.set_state, apt_count, flatpak_count, None)
            except Exception as exc:
                GLib.idle_add(self.set_state, 0, 0, str(exc))
        threading.Thread(target=worker, daemon=True).start()
        return GLib.SOURCE_CONTINUE

    def run(self, args):
        def worker():
            result = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True)
            GLib.idle_add(self.set_state, 0, 0,
                          None if result.returncode == 0 else "A operação de atualização falhou.")
            GLib.timeout_add_seconds(3, self.check)
        threading.Thread(target=worker, daemon=True).start()

    def refresh(self, *_):
        def worker():
            codes = []
            for action in ("apt-refresh", "flatpak-refresh"):
                result = subprocess.run(["pkexec", HELPER, action],
                                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True)
                codes.append(result.returncode)
            GLib.idle_add(self.set_state, 0, 0,
                          None if all(code == 0 for code in codes) else "Falha ao atualizar índices.")
            GLib.timeout_add_seconds(3, self.check)
        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    UpdateIndicator()
    Gtk.main()
