pkgname=forja-plymouth
pkgver=1.0
pkgrel=1
pkgdesc="Integração de inicialização gráfica Plymouth da Forja OS"
arch=('any')
url="https://github.com/cn1988r-coder/forja-iso"
license=('GPL-3.0-or-later')
depends=('plymouth' 'mkinitcpio' 'grub')
backup=('etc/default/grub')
source=(
  'forja-mkinitcpio.conf'
  'plymouthd.conf'
  'forja.plymouth'
  'forja.script'
  'forja-grub'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "$srcdir/forja-mkinitcpio.conf" \
    "$pkgdir/etc/mkinitcpio.conf.d/forja-plymouth.conf"
  install -Dm644 "$srcdir/plymouthd.conf" \
    "$pkgdir/etc/plymouth/plymouthd.conf"
  install -Dm644 "$srcdir/forja.plymouth" \
    "$pkgdir/usr/share/plymouth/themes/forja/forja.plymouth"
  install -Dm644 "$srcdir/forja.script" \
    "$pkgdir/usr/share/plymouth/themes/forja/forja.script"
  install -Dm644 "$srcdir/forja-grub" \
    "$pkgdir/etc/default/grub"
}
