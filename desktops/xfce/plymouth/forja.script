Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

title_image = Image.Text("FORJA OS", 0.92, 0.92, 0.92);
title_sprite = Sprite(title_image);
title_sprite.SetX(screen_width / 2 - title_image.GetWidth() / 2);
title_sprite.SetY(screen_height * 0.43 - title_image.GetHeight() / 2);
title_sprite.SetZ(100);

track_image = Image.Text("....................", 0.24, 0.24, 0.24);
track_sprite = Sprite(track_image);
track_sprite.SetX(screen_width / 2 - track_image.GetWidth() / 2);
track_sprite.SetY(screen_height * 0.55);
track_sprite.SetZ(100);

light_image = Image.Text("●", 0.95, 0.95, 0.95);
light_sprite = Sprite(light_image);
light_sprite.SetY(screen_height * 0.55);
light_sprite.SetZ(101);

step = 0;
max_steps = 20;

fun refresh_callback()
{
    step = (step + 1) % max_steps;
    light_sprite.SetX(screen_width / 2 - track_image.GetWidth() / 2
                      + (track_image.GetWidth() / max_steps) * step);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress)
{
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;
    light_sprite.SetOpacity(0.55 + (progress * 0.45));
}
Plymouth.SetBootProgressFunction(progress_callback);
