#!/usr/bin/env bash
# VENOM first-boot recovery setup. Runs only on the installed target system.
set -Eeuo pipefail

MARKER=/var/lib/venom-os/recovery-configured
LOG=/var/log/venom-recovery-setup.log
install -d -m 0755 /var/log /var/lib/venom-os
exec >>"$LOG" 2>&1

if ! findmnt -n -t btrfs / >/dev/null 2>&1; then
  echo "[VENOM] Raiz não é Btrfs; snapshots Timeshift não serão ativados."
  touch "$MARKER"
  exit 0
fi

ROOT_UUID="$(findmnt -n -o UUID -T /)"
[[ "$ROOT_UUID" =~ ^[A-Fa-f0-9-]+$ ]] || { echo "[VENOM] UUID Btrfs inválido."; exit 1; }

FSTAB=/etc/fstab
grep -Eq '[[:space:]]/[[:space:]].*subvol=/?@([,[:space:]]|$)' "$FSTAB" || {
  echo "[VENOM] fstab não monta o subvolume @ em /."; exit 1;
}
grep -Eq '[[:space:]]/home[[:space:]].*subvol=/?@home([,[:space:]]|$)' "$FSTAB" || {
  echo "[VENOM] fstab não monta @home em /home."; exit 1;
}

install -d -m 0755 /etc/timeshift /etc/mkinitcpio.conf.d
gtk-update-icon-cache -f /usr/share/icons/hicolor || true
papirus-folders -C blue --theme Papirus-Dark
cat >/etc/timeshift/timeshift.json <<EOF
{
  "backup_device_uuid": "$ROOT_UUID",
  "parent_device_uuid": "",
  "do_first_run": "false",
  "btrfs_mode": "true",
  "include_btrfs_home_for_backup": "true",
  "include_btrfs_home_for_restore": "true",
  "stop_cron_emails": "true",
  "btrfs_use_qgroup": "true",
  "schedule_monthly": "false",
  "schedule_weekly": "true",
  "schedule_daily": "true",
  "schedule_hourly": "false",
  "schedule_boot": "false",
  "count_monthly": "2",
  "count_weekly": "3",
  "count_daily": "5",
  "count_hourly": "6",
  "count_boot": "5",
  "snapshot_size": "0",
  "snapshot_count": "0",
  "date_format": "%Y-%m-%d %H:%M:%S",
  "exclude": [],
  "exclude-apps": []
}
EOF

cat >/etc/mkinitcpio.conf.d/venom-btrfs.conf <<'EOF'
MODULES+=(btrfs)
BINARIES+=(btrfs)
EOF

if [[ -f /etc/default/grub ]]; then
  if grep -q '^GRUB_PRELOAD_MODULES=' /etc/default/grub; then
    sed -i 's/^GRUB_PRELOAD_MODULES=.*/GRUB_PRELOAD_MODULES="btrfs"/' /etc/default/grub
  else
    printf '\nGRUB_PRELOAD_MODULES="btrfs"\n' >>/etc/default/grub
  fi
fi

mkinitcpio -P
grub-mkconfig -o /boot/grub/grub.cfg
systemctl enable cronie.service grub-btrfsd.service
systemctl start cronie.service
systemctl start grub-btrfsd.service
timeshift --create --comments "VENOM OS primeiro snapshot" --tags O --scripted
touch "$MARKER"
echo "[VENOM] Timeshift Btrfs e integração GRUB configurados."
