[Toplevel top]
expand=true
orientation=top
size=30

[Toplevel bottom]
expand=true
orientation=bottom
size=30

[Object menu-bar]
object-type=applet
applet-iid=MenuBarFactory::MenuBar
toplevel-id=top
pack-index=0
locked=true

[Object notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=top
pack-type=end
pack-index=2
locked=true

[Object volume-control]
object-type=applet
applet-iid=VolumeControlAppletFactory::VolumeControlApplet
toplevel-id=top
pack-type=end
pack-index=1
locked=true

[Object clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=top
pack-type=end
pack-index=0
locked=true

[Object show-desktop]
object-type=applet
applet-iid=WnckletFactory::ShowDesktopApplet
toplevel-id=bottom
pack-index=0
locked=true

[Object window-list]
object-type=applet
applet-iid=WnckletFactory::WindowListApplet
toplevel-id=bottom
pack-index=1
locked=true

[Object workspace-switcher]
object-type=applet
applet-iid=WnckletFactory::WorkspaceSwitcherApplet
toplevel-id=bottom
pack-type=end
pack-index=0
locked=true
