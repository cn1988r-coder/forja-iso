# Painel inferior unico VENOM MATE. Os applets ficam agrupados na mesma barra.
[Toplevel bottom]
expand=true
orientation=bottom
size=38

[Object menu-bar]
object-type=menu-bar
toplevel-id=bottom
pack-index=0
locked=true

[Object show-desktop]
object-type=applet
applet-iid=WnckletFactory::ShowDesktopApplet
toplevel-id=bottom
pack-index=1
locked=true

[Object window-list]
object-type=applet
applet-iid=WnckletFactory::WindowListApplet
toplevel-id=bottom
pack-index=2
locked=true

[Object notification-area]
object-type=applet
applet-iid=NotificationAreaAppletFactory::NotificationArea
toplevel-id=bottom
pack-type=end
pack-index=3
locked=true

[Object volume-control]
object-type=applet
applet-iid=GvcAppletFactory::GvcApplet
toplevel-id=bottom
pack-type=end
pack-index=2
locked=true

[Object workspace-switcher]
object-type=applet
applet-iid=WnckletFactory::WorkspaceSwitcherApplet
toplevel-id=bottom
pack-type=end
pack-index=1
locked=true

[Object clock]
object-type=applet
applet-iid=ClockAppletFactory::ClockApplet
toplevel-id=bottom
pack-type=end
pack-index=0
locked=true
