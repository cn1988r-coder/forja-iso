#!/usr/bin/env bash
# Backend de instalacao limpa VENOM OS. Executado somente apos confirmacao explicita.
set -Eeuo pipefail
umask 077

log() { printf '[VENOM] %s\n' "$*"; }
fail() { printf '[VENOM][ERRO] %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || fail "O instalador precisa de privilegios de administrador."
[[ $# -eq 14 ]] || fail "Parametros de instalacao invalidos."

DISK="$2"; EDITION="$4"; LOCALE="$6"; KEYMAP="$8"
USERNAME="${10}"; FIRMWARE="${12}"; CONFIRM="${14}"
[[ "$1" == "--disk" && "$3" == "--edition" && "$5" == "--locale" &&
   "$7" == "--keymap" && "$9" == "--username" &&
   "${11}" == "--firmware" && "${13}" == "--confirm" ]] ||
   fail "Sequencia de parametros invalida."
[[ "$CONFIRM" == "APAGAR" ]] || fail "Confirmacao destrutiva ausente."
[[ "$EDITION" == "xfce" || "$EDITION" == "mate" ]] || fail "Edicao desconhecida."
[[ "$FIRMWARE" == "uefi" || "$FIRMWARE" == "bios" ]] || fail "Firmware desconhecido."
[[ "$LOCALE" == "pt_BR.UTF-8" ]] || fail "A VENOM OS utiliza exclusivamente pt_BR.UTF-8."
[[ "$KEYMAP" == "br-abnt2" ]] || fail "A VENOM OS utiliza exclusivamente o teclado br-abnt2."
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,30}$ && "$USERNAME" != root ]] || fail "Nome de usuario invalido."
[[ "$DISK" =~ ^/dev/[a-zA-Z0-9._-]+$ && -b "$DISK" ]] || fail "Disco de destino invalido."
[[ -d /sys/firmware/efi ]] && [[ "$FIRMWARE" == uefi ]] && : || {
  [[ ! -d /sys/firmware/efi && "$FIRMWARE" == bios ]] || fail "Modo de firmware diverge da inicializacao atual."
}

EXPECTED_SIZE="${VENOM_EXPECTED_DISK_BYTES:-0}"
ACTUAL_SIZE="$(blockdev --getsize64 "$DISK")"
[[ "$EXPECTED_SIZE" =~ ^[0-9]+$ && "$EXPECTED_SIZE" == "$ACTUAL_SIZE" ]] ||
  fail "O tamanho do disco mudou desde a selecao."
(( ACTUAL_SIZE >= 20 * 1024 * 1024 * 1024 )) || fail "O disco precisa ter pelo menos 20 GiB."
[[ "$(lsblk -dnro TYPE "$DISK")" == disk ]] || fail "O destino nao e um disco inteiro."
[[ "$(lsblk -dnro RO "$DISK")" == 0 ]] || fail "O disco esta somente para leitura."
if lsblk -nrpo MOUNTPOINT "$DISK" | grep -q '[^[:space:]]'; then
  fail "Existem particoes montadas no disco escolhido."
fi

BOOT_SOURCE="$(findmnt -nro SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
if [[ -n "$BOOT_SOURCE" ]]; then
  BOOT_DISK="$(lsblk -s -nrpo NAME "$BOOT_SOURCE" 2>/dev/null | tail -n1 || true)"
  TARGET_REAL="$(readlink -f "$DISK")"
  [[ -z "$BOOT_DISK" || "$(readlink -f "$BOOT_DISK")" != "$TARGET_REAL" ]] ||
    fail "O disco de inicializacao USB nao pode ser apagado."
fi

MANIFEST="/usr/share/venom/install-packages-${EDITION}.x86_64"
[[ -s "$MANIFEST" ]] || fail "Manifesto da edicao ausente."
[[ -s /etc/pacman.conf ]] || fail "Configuracao do Pacman ausente."
grep -Fxq '[core]' /etc/pacman.conf || fail "Repositorio oficial core do Arch Linux nao configurado."
grep -Fxq '[extra]' /etc/pacman.conf || fail "Repositorio oficial extra do Arch Linux nao configurado."
if grep -Eiq '^\\[venom\\]|file:///usr/share/venom' /etc/pacman.conf; then
  fail "A configuracao nao pode conter repositorio local VENOM."
fi
for cmd in sgdisk partprobe udevadm mkfs.fat mkfs.btrfs mount umount pacstrap genfstab arch-chroot grub-install grub-mkconfig; do
  command -v "$cmd" >/dev/null 2>&1 || fail "Ferramenta obrigatoria ausente: $cmd"
done

log "Sincronizando os repositorios oficiais e validando todos os pacotes ANTES de qualquer alteracao no disco."
pacman -Sy --noconfirm
pacman -Sp --noconfirm --needed "${PACKAGES[@]}" > /run/venom-package-plan.txt ||
  fail "Nao foi possivel resolver todos os pacotes nos repositorios oficiais. O disco permanece intacto."

read -r PASSWORD || fail "Senha nao recebida."
[[ ${#PASSWORD} -ge 8 && ${#PASSWORD} -le 127 ]] || fail "A senha deve ter entre 8 e 127 caracteres."
[[ "$PASSWORD" != *$'\n'* && "$PASSWORD" != *$'\r'* ]] || fail "Senha invalida."

MNT=/mnt/venom-target
cleanup() {
  set +e
  umount -R "$MNT" >/dev/null 2>&1
  rmdir "$MNT" >/dev/null 2>&1
  unset PASSWORD
}
trap cleanup EXIT

if [[ "$DISK" =~ (nvme|mmcblk|loop)[0-9] ]]; then
  P1="${DISK}p1"; P2="${DISK}p2"
else
  P1="${DISK}1"; P2="${DISK}2"
fi

log "Preparando tabela GPT e particoes do disco confirmado."
wipefs --all --force "$DISK"
sgdisk --zap-all "$DISK"
if [[ "$FIRMWARE" == uefi ]]; then
  sgdisk --new=1:0:+1024M --typecode=1:ef00 --change-name=1:VENOM_EFI \
         --new=2:0:0 --typecode=2:8300 --change-name=2:VENOM_ROOT "$DISK"
else
  sgdisk --new=1:0:+2M --typecode=1:ef02 --change-name=1:VENOM_BIOS \
         --new=2:0:0 --typecode=2:8300 --change-name=2:VENOM_ROOT "$DISK"
fi
partprobe "$DISK"
udevadm settle
for _ in {1..20}; do [[ -b "$P2" ]] && break; sleep 1; done
[[ -b "$P2" ]] || fail "As particoes nao apareceram apos a tabela GPT."

if [[ "$FIRMWARE" == uefi ]]; then
  mkfs.fat -F32 -n VENOM_EFI "$P1"
fi
mkfs.btrfs -f -L VENOM_ROOT "$P2"
mkdir -p "$MNT"
mount "$P2" "$MNT"
btrfs subvolume create "$MNT/@"
btrfs subvolume create "$MNT/@home"
umount "$MNT"
mount -o noatime,compress=zstd,subvol=@ "$P2" "$MNT"
mkdir -p "$MNT/home"
mount -o noatime,compress=zstd,subvol=@home "$P2" "$MNT/home"
if [[ "$FIRMWARE" == uefi ]]; then
  mkdir -p "$MNT/boot/efi"
  mount "$P1" "$MNT/boot/efi"
fi

mapfile -t PACKAGES < <(grep -Ev '^[[:space:]]*(#|$)' "$MANIFEST")
(("${#PACKAGES[@]}" > 0)) || fail "Manifesto de pacotes vazio."
log "Instalando a edicao ${EDITION^^} diretamente dos repositorios oficiais Arch Linux."
pacstrap -C /etc/pacman.conf -K "$MNT" "${PACKAGES[@]}"
# Aplica a base visual e os arquivos de primeiro login compartilhados pelas edicoes.
[[ -d /usr/share/venom/install-overlay ]] || fail "Arquivos visuais VENOM ausentes na midia."
cp -a /usr/share/venom/install-overlay/. "$MNT/"
if [[ -f "$MNT/usr/local/bin/venom-mate-first-login" ]]; then chmod 0755 "$MNT/usr/local/bin/venom-mate-first-login"; fi
genfstab -U "$MNT" > "$MNT/etc/fstab"
install -d "$MNT/etc"
printf '%s\n' "$LOCALE UTF-8" > "$MNT/etc/locale.gen"
arch-chroot "$MNT" locale-gen
printf 'LANG=%s\n' "$LOCALE" > "$MNT/etc/locale.conf"
ln -sf /usr/share/zoneinfo/America/Sao_Paulo "$MNT/etc/localtime"
printf 'KEYMAP=%s\n' "$KEYMAP" > "$MNT/etc/vconsole.conf"
printf 'VENOM-OS\n' > "$MNT/etc/hostname"
cat > "$MNT/etc/hosts" <<'EOF'
127.0.0.1 localhost
::1 localhost
127.0.1.1 VENOM-OS.localdomain VENOM-OS
EOF
arch-chroot "$MNT" useradd -m -G wheel,audio,video,storage,power -s /bin/bash "$USERNAME"
printf '%s:%s\n' "$USERNAME" "$PASSWORD" | arch-chroot "$MNT" chpasswd
unset PASSWORD
printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$MNT/etc/sudoers.d/10-wheel"
chmod 0440 "$MNT/etc/sudoers.d/10-wheel"
install -d "$MNT/etc/X11/xorg.conf.d"
if [[ "$KEYMAP" == br-abnt2 ]]; then
  printf 'Section "InputClass"\n    Identifier "VENOM keyboard"\n    MatchIsKeyboard "on"\n    Option "XkbLayout" "br"\n    Option "XkbVariant" "abnt2"\nEndSection\n' > "$MNT/etc/X11/xorg.conf.d/00-keyboard.conf"
else
  printf 'Section "InputClass"\n    Identifier "VENOM keyboard"\n    MatchIsKeyboard "on"\n    Option "XkbLayout" "us"\nEndSection\n' > "$MNT/etc/X11/xorg.conf.d/00-keyboard.conf"
fi
install -d "$MNT/etc/lightdm/lightdm.conf.d"
printf '[Seat:*]\nuser-session=%s\ngreeter-session=lightdm-gtk-greeter\n' "$EDITION" > "$MNT/etc/lightdm/lightdm.conf.d/50-venom-session.conf"
arch-chroot "$MNT" dconf update
arch-chroot "$MNT" mkinitcpio -P
arch-chroot "$MNT" systemctl enable NetworkManager.service bluetooth.service lightdm.service cronie.service grub-btrfsd.service
if [[ "$FIRMWARE" == uefi ]]; then
  arch-chroot "$MNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=VENOM
else
  arch-chroot "$MNT" grub-install --target=i386-pc "$DISK"
fi
arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg
log "Instalacao concluida. Removendo montagens e preparando reinicializacao."
trap - EXIT
cleanup
log "VENOM OS ${EDITION^^} instalada. Remova a midia USB e reinicie."
