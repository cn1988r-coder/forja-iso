#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  printf '%s\\n' 'VENON: execute com sudo para instalar atualizações quando o mecanismo estiver disponível.' >&2
  exit 1
fi

printf '%s\\n' 'VENON: o mecanismo independente ainda não está configurado.'
printf '%s\\n' 'Nenhum pacote foi baixado, instalado ou alterado.'
printf '%s\\n' 'Quando estiver implementado, este comando só instalará atualizações após confirmação explícita.'
exit 2
