#!/usr/bin/env bash
set -Eeuo pipefail
LOG=/var/log/venom-live-setup.log
install -d -m 0755 /var/log
touch "$LOG"
exec > >(tee -a "$LOG" /dev/ttyS0) 2>&1
trap 'rc=$?; printf "[VENOM] Setup falhou status=%s comando=%s\n" "$rc" "$BASH_COMMAND" | tee -a "$LOG" /dev/ttyS0; exit "$rc"' ERR

serial_marker() { printf '%s %s\n' "$(date -Is)" "$1" | tee -a "$LOG" /dev/ttyS0; }
serial_marker VENOM_LIVE_SETUP_STARTED
printf '[VENOM] Configurando ambiente live...\n'

getent group autologin >/dev/null || groupadd --system autologin
if ! id venom >/dev/null 2>&1; then
  useradd --create-home --groups wheel,audio,video,storage,autologin --shell /bin/bash venom
  passwd --delete venom
fi
# Arch's LightDM autologin PAM policy requires membership in this group.
usermod --append --groups autologin venom
install -d -o venom -g venom -m 0755 /home/venom
if [[ -d /etc/skel ]]; then cp -a /etc/skel/. /home/venom/; fi
chown -R venom:venom /home/venom
install -d -m 0755 /etc/sudoers.d
printf 'venom ALL=(root) NOPASSWD: /usr/bin/calamares, /usr/bin/pacman\n' >/etc/sudoers.d/10-venom-live
chmod 0440 /etc/sudoers.d/10-venom-live
visudo -cf /etc/sudoers.d/10-venom-live

systemctl set-default graphical.target
papirus-folders -C blue --theme Papirus-Dark || true
systemctl enable NetworkManager.service bluetooth.service lightdm.service
systemctl start --no-block NetworkManager.service || true
systemctl start --no-block bluetooth.service || true

# This setup unit is ordered Before=lightdm.service. Queue LightDM without
# waiting here; a synchronous start would deadlock on that ordering.
systemctl start --no-block lightdm.service
systemctl start --no-block venom-live-ready.service
serial_marker VENOM_LIVE_SETUP_COMPLETE
printf '[VENOM] Configuração concluída; aguardando LightDM iniciar.\n'
