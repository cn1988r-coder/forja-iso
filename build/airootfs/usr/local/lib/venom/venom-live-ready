#!/usr/bin/env bash
set -Eeuo pipefail
LOG=/var/log/venom-live-setup.log
serial_marker() {
  local line
  line="$(date -Is) $1"
  printf '%s\n' "$line" | tee -a "$LOG" /dev/ttyS0
}
for attempt in $(seq 1 60); do
  if systemctl is-active --quiet lightdm.service; then
    serial_marker VENOM_LIVE_READY
    printf '[VENOM] LightDM ativo; ambiente live pronto.\n'
    exit 0
  fi
  sleep 1
done
serial_marker VENOM_LIVE_LIGHTDM_FAILED
systemctl --no-pager --full status lightdm.service || true
exit 1
