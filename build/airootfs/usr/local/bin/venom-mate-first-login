#!/usr/bin/env bash
# Implementação VENOM do manjaro-mate-dark-complete.sh.
# Executado no primeiro login gráfico do usuário, nunca durante o build como root.
set -Eeuo pipefail

log() { printf '[VENOM MATE] %s\n' "$*"; }
warn() { printf '[VENOM MATE] AVISO: %s\n' "$*" >&2; }

[[ "$EUID" -ne 0 ]] || { warn "Execute como usuário normal."; exit 1; }
command -v gsettings >/dev/null 2>&1 || { warn "Sessão MATE indisponível; tente novamente após entrar no desktop."; exit 0; }
marker="$HOME/.config/venom-mate-setup.done"
[[ -e "$marker" ]] && exit 0

# Instalação AUR equivalente às etapas Brisk Menu e Bibata do script original.
AUR_HELPER=""
command -v yay >/dev/null 2>&1 && AUR_HELPER="yay"
if [[ -z "$AUR_HELPER" ]] && command -v paru >/dev/null 2>&1; then AUR_HELPER="paru"; fi
if [[ -z "$AUR_HELPER" ]]; then
    log "Preparando ferramentas para instalar os componentes AUR."
    if ! command -v git >/dev/null 2>&1 || ! command -v makepkg >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm git base-devel
    fi
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT
    git clone https://aur.archlinux.org/yay-bin.git "$tmp_dir/yay-bin"
    (cd "$tmp_dir/yay-bin" && makepkg -si --noconfirm)
    command -v yay >/dev/null 2>&1 && AUR_HELPER="yay"
fi
if [[ -n "$AUR_HELPER" ]]; then
    log "Instalando Brisk Menu e Bibata pelo AUR."
    if "$AUR_HELPER" -S --needed --noconfirm brisk-menu-git; then
        log "Brisk Menu instalado; recarregando o layout VENOM preservando a área de notificação."
        gsettings set org.mate.panel default-layout "'venom'" || true
        mate-panel --reset & sleep 2
    else
        warn "Brisk Menu não pôde ser instalado automaticamente."
    fi
    "$AUR_HELPER" -S --needed --noconfirm bibata-cursor-theme-bin || \
        warn "Bibata não pôde ser instalado automaticamente."
else
    warn "Nenhum helper AUR disponível; Brisk Menu e Bibata ficaram pendentes."
fi

set_setting() {
    local schema="$1" key="$2" value="$3"
    if gsettings list-schemas | grep -Fxq "$schema"; then
        gsettings set "$schema" "$key" "$value" || warn "Falha ao aplicar $schema.$key"
    else
        warn "Schema indisponível: $schema"
    fi
}

log "Aplicando Materia Dark, Papirus-Dark e Bibata."
set_setting org.mate.interface gtk-theme "'Materia-dark'"
set_setting org.mate.Marco.general theme "'Materia-dark'"
set_setting org.mate.interface metacity-theme "'Materia-dark'"
set_setting org.mate.interface icon-theme "'Papirus-Dark'"
set_setting org.mate.peripherals-mouse cursor-theme "'Bibata-Modern-Classic'"
set_setting org.mate.peripherals-mouse cursor-size "24"
set_setting org.mate.interface gtk-application-prefer-dark-theme "true"

# Mantém o layout VENOM já validado, com os indicadores de rede, Bluetooth e volume.
# O painel só é recarregado quando o Brisk Menu é instalado com sucesso.

wall_dir="${XDG_DATA_HOME:-$HOME/.local/share}/wallpapers"
wall_file="$wall_dir/moon-grey-4k.jpg"
wall_url="https://wallpapers.com/images/wallpapers/magnificavista-de-uma-lua-cheia-no-ceu-noturno-4q7f0ei1u5yvrwp0.jpg"
mkdir -p "$wall_dir"
if [[ ! -s "$wall_file" ]]; then
    log "Baixando wallpaper 4K original da Lua."
    if ! curl --fail --location --retry 3 --connect-timeout 15 "$wall_url" --output "$wall_file"; then
        rm -f "$wall_file"
        warn "Download do wallpaper falhou; será tentado novamente no próximo login."
    fi
fi
if [[ -s "$wall_file" ]]; then
    if gsettings list-schemas | grep -Fxq org.mate.desktop.background; then
        gsettings set org.mate.desktop.background picture-uri "'file://$wall_file'" || \
        gsettings set org.mate.desktop.background picture-filename "'$wall_file'" || true
    elif gsettings list-schemas | grep -Fxq org.mate.background; then
        gsettings set org.mate.background picture-filename "'$wall_file'" || true
    else
        warn "Schema de papel de parede MATE não encontrado."
    fi
fi

if gsettings list-schemas | grep -Fxq com.solus-project.brisk-menu; then
    gsettings set com.solus-project.brisk-menu label-visible false || true
fi
if pacman -Q brisk-menu-git >/dev/null 2>&1 && pacman -Q bibata-cursor-theme-bin >/dev/null 2>&1 && [[ -s "$wall_file" ]]; then
    mkdir -p "$HOME/.config"
    touch "$marker"
fi
log "Configuração MATE finalizada."
