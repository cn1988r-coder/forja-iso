{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#2588ff",
      "2": "#ffffff"
    },
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#2588ff",
      "title": "#ffffff",
      "output": "#ffffff",
      "separator": "#ffffff"
    },
    "key": {
      "width": 12,
      "type": "string"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "format": "{pretty-name}" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel", "format": "{pretty-name} {release}" },
    "uptime",
    { "type": "packages", "key": "Packages" },
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "icons",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    { "type": "memory", "key": "Memory", "format": "{used} / {total}" }
  ]
}
