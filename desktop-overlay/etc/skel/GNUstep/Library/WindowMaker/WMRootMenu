"V  |  BuildMaker" MENU
  "Aplicativos" MENU
    "Navegador  |  Firefox" EXEC firefox
    "Loja de aplicativos  |  Pamac" EXEC pamac-manager
    "Monitor do sistema" EXEC xfce4-taskmanager
    "Terminal" EXEC xfce4-terminal
    "Gerenciador de arquivos" EXEC thunar
  "Aplicativos" END
  "Configurações" MENU
    "Aparência e temas" EXEC lxappearance
    "Áudio" EXEC pavucontrol
    "Rede" EXEC nm-connection-editor
    "Bluetooth" EXEC blueman-manager
    "Gerenciador de janelas" EXEC wmaker
  "Configurações" END
  "Sistema" MENU
    "Visão geral do sistema" EXEC xfce4-terminal --command=fastfetch
    "Processos em execução" EXEC xfce4-terminal --command=htop
    "Atualizações e programas" EXEC pamac-manager
  "Sistema" END
  "Energia" MENU
    "Suspender" EXEC systemctl suspend
    "Hibernar" EXEC systemctl hibernate
    "Reiniciar" EXEC systemctl reboot
    "Desligar" EXEC systemctl poweroff
  "Energia" END
  "Sair da sessão" EXIT
"V  |  BuildMaker" END
