#!/bin/sh
# Window Maker session startup. Commands are optional and start only once.
command -v tint2 >/dev/null 2>&1 && (pgrep -x tint2 >/dev/null || tint2) &
command -v conky >/dev/null 2>&1 && (pgrep -x conky >/dev/null || conky -c "$HOME/.config/conky/conky.conf") &
command -v wbar >/dev/null 2>&1 && (pgrep -x wbar >/dev/null || "$HOME/.config/wbar/dot") &
command -v conky >/dev/null 2>&1 && (pgrep -f 'conky -c .*clock.conf' >/dev/null || conky -c "$HOME/.config/conky/clock.conf") &
exit 0
