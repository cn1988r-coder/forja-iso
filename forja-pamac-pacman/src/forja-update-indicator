#!/usr/bin/python3
"""Indicador de atualizações da Forja OS para a área de notificação do painel MATE."""
import subprocess
import threading
import shutil
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

HELPER = "/usr/lib/forja/forja-pacman-transaction"
ICON = "software-update-available"

def run(args, timeout=90):
    try:
        return subprocess.run(args, text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(args, 1, "", str(exc))

class UpdateIndicator:
    def __init__(self):
        self.icon = Gtk.StatusIcon.new_from_icon_name(ICON)
        self.icon.set_title("Atualizações da FORJA OS")
        self.icon.set_tooltip_text("Verificando atualizações…")
        self.icon.set_visible(True)
        self.menu = Gtk.Menu()
        self.state = Gtk.MenuItem(label="Verificando atualizações…")
        self.state.set_sensitive(False)
        self.menu.append(self.state)
        self.menu.append(Gtk.SeparatorMenuItem())
        self.add_item("Abrir Forja Store", self.open_store)
        self.add_item("Verificar atualizações", self.check)
        self.add_item("Instalar atualizações", self.upgrade)
        self.menu.show_all()
        self.icon.connect("activate", self.open_store)
        self.icon.connect("popup-menu", self.popup)
        self.check()
        GLib.timeout_add_seconds(1800, self.check)

    def add_item(self, label, callback):
        item = Gtk.MenuItem(label=label)
        item.connect("activate", callback)
        self.menu.append(item)

    def popup(self, _icon, button, activate_time):
        self.menu.popup_at_pointer(None)

    def set_state(self, count, flatpak_count, error):
        total = count + flatpak_count
        if error:
            label = "Não foi possível verificar atualizações"
            tooltip = "A verificação de atualizações encontrou um erro."
        elif total:
            label = f"{total} atualização(ões) disponível(is)"
            tooltip = f"{count} do sistema · {flatpak_count} Flatpak"
        else:
            label = "O sistema está atualizado"
            tooltip = "FORJA OS está atualizada."
        self.state.set_label(label)
        self.icon.set_tooltip_text(tooltip)
        self.icon.set_from_icon_name("software-update-available" if total or error else "emblem-default")
        return GLib.SOURCE_REMOVE

    def check(self, *_):
        self.state.set_label("Verificando atualizações…")
        def worker():
            pac = run(["checkupdates"], 180)
            count = len([line for line in pac.stdout.splitlines() if line.strip()])
            error = pac.returncode not in (0, 2)
            flat_count = 0
            if shutil.which("flatpak"):
                for scope in ("--system", "--user"):
                    result = run(["flatpak", "remote-ls", scope, "--updates",
                                  "--columns=application"], 180)
                    if result.returncode == 0:
                        flat_count += len([line for line in result.stdout.splitlines() if line.strip()])
                    elif "No remote refs found" not in result.stderr:
                        error = True
            GLib.idle_add(self.set_state, count, flat_count, error)
        threading.Thread(target=worker, daemon=True).start()
        return GLib.SOURCE_REMOVE

    def open_store(self, *_):
        subprocess.Popen(["forja-store"])

    def upgrade(self, *_):
        self.state.set_label("Instalando atualizações…")
        def worker():
            result = run(["pkexec", HELPER, "upgrade"], 7200)
            if result.returncode == 0 and shutil.which("flatpak"):
                run(["flatpak", "update", "--user", "--noninteractive", "--assumeyes"], 7200)
            GLib.idle_add(self.check)
        threading.Thread(target=worker, daemon=True).start()

if __name__ == "__main__":
    UpdateIndicator()
    Gtk.main()
