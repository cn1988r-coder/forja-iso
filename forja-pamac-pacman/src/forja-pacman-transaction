#!/usr/bin/python3
"""Restricted privileged helper for Manjaro/Arch package transactions."""
import re
import shutil
import subprocess
import sys

NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._+:-]*$")
ACTIONS = {"check", "install", "remove", "upgrade", "flatpak-upgrade"}

def run(command):
    return subprocess.call(command)

def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ACTIONS:
        print("Uso: forja-pacman-transaction {check|install|remove|upgrade|flatpak-upgrade} [pacote...]")
        return 2
    action, packages = sys.argv[1], sys.argv[2:]
    if action in {"install", "remove"} or (action == "upgrade" and packages):
        if not packages or any(not NAME.fullmatch(p) for p in packages):
            print("Nome de pacote inválido.")
            return 2
    elif packages:
        print("Esta ação não aceita argumentos.")
        return 2
    if action == "check":
        return run(["checkupdates"])
    if action == "flatpak-upgrade":
        if not shutil.which("flatpak"):
            return 0
        return run(["flatpak", "update", "--system", "--noninteractive", "--assumeyes"])
    if action == "upgrade":
        if packages:
            return run(["pacman", "-S", "--needed", *packages])
        result = run(["pacman", "-Syu"])
        if result != 0 or not shutil.which("flatpak"):
            return result
        return run(["flatpak", "update", "--system", "--noninteractive", "--assumeyes"])
    if action == "install":
        return run(["pacman", "-S", "--needed", *packages])
    if action == "remove":
        return run(["pacman", "-Rns", *packages])
    return 2

if __name__ == "__main__":
    raise SystemExit(main())
