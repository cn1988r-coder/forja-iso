#!/usr/bin/python3
"""Operações privilegiadas da Forja Store: Pacman, AUR e Flatpak."""
import os
import pwd
import re
import shutil
import subprocess
import sys

PACKAGE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._+:-]*$")
APP_ID = re.compile(r"^[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)+$")
REMOTE = re.compile(r"^[A-Za-z0-9_.-]+$")
ACTIONS = {"check", "install", "remove", "upgrade", "flatpak-upgrade"}

def call(args, timeout=None):
    try:
        return subprocess.call(args, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(str(exc), file=sys.stderr)
        return 1

def desktop_user():
    raw = os.environ.get("PKEXEC_UID", "")
    if not raw.isdigit():
        raise RuntimeError("Não foi possível identificar o usuário que iniciou a operação.")
    user = pwd.getpwuid(int(raw))
    if user.pw_uid == 0:
        raise RuntimeError("Operações AUR não podem ser executadas como root.")
    return user

def user_environment(user):
    env = [
        "HOME=" + user.pw_dir, "USER=" + user.pw_name,
        "LOGNAME=" + user.pw_name, "PATH=/usr/local/bin:/usr/bin",
    ]
    for key in ("DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
                "DBUS_SESSION_BUS_ADDRESS", "XAUTHORITY", "LANG"):
        if os.environ.get(key):
            env.append(key + "=" + os.environ[key])
    return env

def aur_command(args):
    yay = shutil.which("yay")
    if not yay:
        print("O helper yay não está instalado.", file=sys.stderr)
        return 127
    try:
        user = desktop_user()
    except (KeyError, ValueError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    command = [
        "runuser", "-u", user.pw_name, "--", "env", *user_environment(user),
        yay, "--sudo", "/usr/lib/forja/forja-pkexec-sudo", *args,
    ]
    return call(command, 7200)

def flatpak_user_command(user, args):
    return call([
        "runuser", "-u", user.pw_name, "--", "env", *user_environment(user),
        "flatpak", *args,
    ], 7200)

def ensure_flatpak_remote(remote):
    if not shutil.which("flatpak"):
        print("Flatpak não está instalado.", file=sys.stderr)
        return 127
    if not REMOTE.fullmatch(remote):
        print("Nome de repositório Flatpak inválido.", file=sys.stderr)
        return 2
    if remote != "flathub":
        result = subprocess.run(
            ["flatpak", "remotes", "--system", "--columns=name"],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        if result.returncode or remote not in result.stdout.splitlines():
            print("O repositório Flatpak selecionado não está configurado no sistema.", file=sys.stderr)
            return 1
        return 0
    return call([
        "flatpak", "remote-add", "--if-not-exists", "--system",
        "flathub", "https://flathub.org/repo/flathub.flatpakrepo",
    ], 180)

def flatpak_remove(name):
    removed = False
    system = subprocess.run(
        ["flatpak", "info", "--system", name],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if system.returncode == 0:
        result = call([
            "flatpak", "uninstall", "--system", "--noninteractive",
            "--assumeyes", "--delete-data", name,
        ], 7200)
        if result:
            return result
        removed = True
    try:
        user = desktop_user()
    except (KeyError, ValueError, RuntimeError) as exc:
        if not removed:
            print(str(exc), file=sys.stderr)
            return 1
        return 0
    if flatpak_user_command(user, ["info", "--user", name]) == 0:
        result = flatpak_user_command(user, [
            "uninstall", "--user", "--noninteractive", "--assumeyes",
            "--delete-data", name,
        ])
        if result:
            return result
        removed = True
    if not removed:
        print("Aplicativo Flatpak não encontrado nas instalações system ou user.", file=sys.stderr)
        return 1
    return 0

def upgrade_system():
    pacman = call(["pacman", "-Syu", "--noconfirm"], 7200)
    if pacman:
        print("A atualização do Pacman falhou; as atualizações AUR foram interrompidas para evitar compilações sobre uma base inconsistente.", file=sys.stderr)
        return pacman
    aur = aur_command(["-Sua", "--noconfirm"])
    flatpak = call([
        "flatpak", "update", "--system", "--noninteractive", "--assumeyes",
    ], 7200) if shutil.which("flatpak") else 127
    if aur or flatpak:
        if aur:
            print("Falha ao atualizar pacotes AUR.", file=sys.stderr)
        if flatpak:
            print("Falha ao atualizar aplicativos Flatpak do sistema.", file=sys.stderr)
        return aur or flatpak
    return 0

def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] not in ACTIONS:
        print("Uso: forja-pacman-transaction {check|install|remove|upgrade|flatpak-upgrade} [repo|aur|flatpak] [pacote] [remote]", file=sys.stderr)
        return 2
    action = argv.pop(0)
    if action == "check":
        if argv:
            return 2
        return call(["checkupdates"])
    if action == "upgrade":
        if argv:
            return 2
        return upgrade_system()
    if action == "flatpak-upgrade":
        if argv:
            return 2
        if not shutil.which("flatpak"):
            print("Flatpak não está instalado.", file=sys.stderr)
            return 127
        return call(["flatpak", "update", "--system", "--noninteractive", "--assumeyes"], 7200)
    if len(argv) not in (2, 3):
        return 2
    source, name = argv[:2]
    remote = argv[2] if len(argv) == 3 else "flathub"
    if source == "flatpak":
        if not shutil.which("flatpak"):
            print("Flatpak não está instalado.", file=sys.stderr)
            return 127
        if action not in ("install", "remove") or not APP_ID.fullmatch(name):
            print("ID ou operação Flatpak inválida.", file=sys.stderr)
            return 2
        if action == "remove":
            return flatpak_remove(name)
        remote_status = ensure_flatpak_remote(remote)
        if remote_status:
            return remote_status
        return call([
            "flatpak", "install", "--system", "--noninteractive",
            "--assumeyes", remote, name,
        ], 7200)
    if len(argv) != 2 or not PACKAGE.fullmatch(name):
        print("Nome de pacote inválido.", file=sys.stderr)
        return 2
    if source == "repo":
        if action == "install":
            return call(["pacman", "-S", "--needed", "--noconfirm", name], 7200)
        if action == "remove":
            return call(["pacman", "-Rns", "--noconfirm", name], 7200)
        return 2
    if source == "aur":
        if action == "install":
            return aur_command(["-S", "--aur", "--needed", "--noconfirm", name])
        if action == "remove":
            return aur_command(["-Rns", "--noconfirm", name])
        return 2
    print("Origem de pacote desconhecida.", file=sys.stderr)
    return 2

if __name__ == "__main__":
    raise SystemExit(main())
