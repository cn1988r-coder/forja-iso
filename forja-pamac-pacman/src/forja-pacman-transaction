#!/usr/bin/python3
"""Adaptador da Forja Store: transações delegadas ao Pamac e Flatpak."""
import re
import shutil
import subprocess
import sys

PACKAGE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._+:-]*$")
APP_ID = re.compile(r"^[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)+$")
REMOTE = re.compile(r"^[A-Za-z0-9_.-]+$")

def call(args, timeout=7200):
    try:
        return subprocess.call(args, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(str(exc), file=sys.stderr)
        return 1

def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        print("Uso: forja-pacman-transaction {install|remove|upgrade} [repo|aur|flatpak] [pacote] [remote]", file=sys.stderr)
        return 2
    action = args.pop(0)
    if not shutil.which("pamac"):
        print("Pamac CLI não está instalado.", file=sys.stderr)
        return 127
    if action == "upgrade":
        if args:
            return 2
        result = call(["pamac", "upgrade", "--aur", "--no-confirm"])
        if result:
            print("A atualização do Pamac falhou; Flatpak não foi atualizado.", file=sys.stderr)
            return result
        if shutil.which("flatpak"):
            return call(["flatpak", "update", "--system", "--noninteractive", "--assumeyes"])
        return 0
    if action not in ("install", "remove") or len(args) not in (2, 3):
        return 2
    source, name = args[:2]
    remote = args[2] if len(args) == 3 else "flathub"
    if source in ("repo", "aur"):
        if not PACKAGE.fullmatch(name):
            print("Nome de pacote inválido.", file=sys.stderr)
            return 2
        if source == "repo":
            command = ["pamac", "install" if action == "install" else "remove", "--no-confirm", name]
        elif action == "install":
            command = ["pamac", "build", "--no-confirm", name]
        else:
            command = ["pamac", "remove", "--no-confirm", name]
        return call(command)
    if source == "flatpak":
        if not shutil.which("flatpak"):
            print("Flatpak não está instalado.", file=sys.stderr)
            return 127
        if not APP_ID.fullmatch(name) or not REMOTE.fullmatch(remote):
            print("ID Flatpak ou repositório inválido.", file=sys.stderr)
            return 2
        if action == "install":
            if remote == "flathub":
                result = call(["flatpak", "remote-add", "--if-not-exists", "--system",
                               "flathub", "https://flathub.org/repo/flathub.flatpakrepo"], 180)
                if result:
                    return result
            return call(["flatpak", "install", "--system", "--noninteractive",
                         "--assumeyes", remote, name])
        return call(["flatpak", "uninstall", "--system", "--noninteractive",
                     "--assumeyes", "--delete-data", name])
    print("Origem de pacote desconhecida.", file=sys.stderr)
    return 2

if __name__ == "__main__":
    raise SystemExit(main())
