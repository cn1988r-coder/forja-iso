#!/usr/bin/python3
"""Transações privilegiadas da Forja Store: Pacman, AUR (yay) e Flatpak."""
import os
import pwd
import re
import shutil
import subprocess
import sys

PACKAGE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._+:-]*$")
APP_ID = re.compile(r"^[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)+$")
ACTIONS = {"check", "install", "remove", "upgrade", "flatpak-upgrade"}

def call(args, timeout=None):
    try:
        return subprocess.call(args, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(str(exc), file=sys.stderr)
        return 1

def desktop_user():
    raw = os.environ.get("PKEXEC_UID", "")
    if not raw.isdigit():
        raise RuntimeError("Não foi possível identificar o usuário que iniciou a operação.")
    user = pwd.getpwuid(int(raw))
    if user.pw_uid == 0:
        raise RuntimeError("Operações AUR não podem ser executadas como root.")
    return user

def aur_command(args):
    helper = shutil.which("yay")
    if not helper:
        print("O helper yay não está instalado. Instale o pacote yay dos repositórios Manjaro.", file=sys.stderr)
        return 127
    try:
        user = desktop_user()
    except (KeyError, ValueError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    env = ["env", "HOME=" + user.pw_dir, "USER=" + user.pw_name,
           "LOGNAME=" + user.pw_name, "PATH=/usr/local/bin:/usr/bin"]
    for key in ("DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
                "DBUS_SESSION_BUS_ADDRESS", "XAUTHORITY", "LANG"):
        if os.environ.get(key):
            env.append(key + "=" + os.environ[key])
    command = ["runuser", "-u", user.pw_name, "--", *env, helper,
               "--sudo", "/usr/lib/forja/forja-pkexec-sudo", *args]
    return call(command, 7200)

def ensure_flatpak_remote():
    if not shutil.which("flatpak"):
        print("Flatpak não está instalado.", file=sys.stderr)
        return 127
    return call(["flatpak", "remote-add", "--if-not-exists", "--system",
                 "flathub", "https://flathub.org/repo/flathub.flatpakrepo"], 180)

def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] not in ACTIONS:
        print("Uso: forja-pacman-transaction {check|install|remove|upgrade|flatpak-upgrade} [repo|aur|flatpak] [pacote]", file=sys.stderr)
        return 2
    action = argv.pop(0)
    if action == "check":
        return call(["checkupdates"])
    if action == "upgrade":
        if argv:
            return 2
        result = call(["pacman", "-Syu", "--noconfirm"], 7200)
        if result:
            return result
        if not shutil.which("yay"):
            print("Dependência ausente: yay (AUR).", file=sys.stderr)
            return 127
        result = aur_command(["-Sua", "--noconfirm"])
        if result:
            return result
        if not shutil.which("flatpak"):
            print("Dependência ausente: flatpak.", file=sys.stderr)
            return 127
        return call(["flatpak", "update", "--system", "--noninteractive", "--assumeyes"], 7200)
    if action == "flatpak-upgrade":
        if argv:
            return 2
        if not shutil.which("flatpak"):
            print("Dependência ausente: flatpak.", file=sys.stderr)
            return 127
        return call(["flatpak", "update", "--system", "--noninteractive", "--assumeyes"], 7200)
    if len(argv) != 2:
        return 2
    source, name = argv
    if source == "flatpak":
        if not APP_ID.fullmatch(name):
            print("ID Flatpak inválido.", file=sys.stderr)
            return 2
        if action == "install":
            if ensure_flatpak_remote():
                return 1
            return call(["flatpak", "install", "--system", "--noninteractive", "--assumeyes", "flathub", name], 7200)
        if action == "remove":
            scope = "--system" if call(["flatpak", "info", "--system", name]) == 0 else "--user"
            return call(["flatpak", "uninstall", scope, "--noninteractive", "--assumeyes", "--delete-data", name], 7200)
        return 2
    if not PACKAGE.fullmatch(name):
        print("Nome de pacote inválido.", file=sys.stderr)
        return 2
    if source == "repo":
        if action == "install":
            return call(["pacman", "-S", "--needed", "--noconfirm", name], 7200)
        if action == "remove":
            return call(["pacman", "-Rns", "--noconfirm", name], 7200)
        return 2
    if source == "aur":
        if action == "install":
            return aur_command(["-S", "--needed", "--noconfirm", name])
        if action == "remove":
            return aur_command(["-Rns", "--noconfirm", name])
        return 2
    return 2

if __name__ == "__main__":
    raise SystemExit(main())
