        self.window.show_all()
        if self.open_updates:
            self.side.select_row(self.category_rows["updates"])
        self.reload_installed()

    def clear(self):
        for child in self.content.get_children():
            self.content.remove(child)
        self.grid = None

    def heading(self, text):
        label = Gtk.Label(label=text, xalign=0)
        label.get_style_context().add_class("section-title")
        self.content.pack_start(label, False, False, 0)

    def on_category(self, _list, row):
        if row:
            self.category = row.key
            self.search.set_text("")
            self.show_category()

    def on_search(self, *_):
        if self.search_timeout:
            GLib.source_remove(self.search_timeout)
        query = self.search.get_text().strip()
        if not query:
            self.query_generation += 1
            return
        self.search_timeout = GLib.timeout_add(350, self.start_search, query)

    def start_search(self, query):
        self.search_timeout = 0
        self.category = "search"
        self.search_packages(query)
        return GLib.SOURCE_REMOVE

    def reload_installed(self):
        def worker():
            repo = run(["pamac", "list", "--installed", "--quiet"], 60)
            foreign = run(["pamac", "list", "--foreign", "--quiet"], 60)
            system_flat = run(["flatpak", "list", "--system", "--app", "--columns=application"], 60) if shutil.which("flatpak") else None
            user_flat = run(["flatpak", "list", "--user", "--app", "--columns=application"], 60) if shutil.which("flatpak") else None
            GLib.idle_add(
                self.set_installed,
                set(repo.stdout.splitlines()) if repo.returncode == 0 else set(),
                set(foreign.stdout.splitlines()) if foreign.returncode == 0 else set(),
                (set(system_flat.stdout.splitlines()) if system_flat and system_flat.returncode == 0 else set())
                | (set(user_flat.stdout.splitlines()) if user_flat and user_flat.returncode == 0 else set()),
            )
        threading.Thread(target=worker, daemon=True).start()

    def set_installed(self, repo, aur, flat):
        self.installed_repo = repo
        self.installed_aur = aur
        self.installed_flatpak = flat
        if self.category not in ("search", "updates"):
            self.show_category()
        return GLib.SOURCE_REMOVE

    def show_category(self):
        if self.category == "home":
            self.load_featured()
        elif self.category == "updates":
            self.load_updates()
        elif self.category == "aur":
            self.clear()
            self.heading("Pacotes do AUR")
            self.content.pack_start(
                Gtk.Label(label="O AUR não oferece um catálogo completo e confiável para navegação por categorias. Use a pesquisa acima para consultar os pacotes publicados no AUR.", xalign=0, yalign=0, wrap=True),
                False, False, 0,
            )
            self.status.set_text("AUR: pesquisa sob demanda. Revise sempre o PKGBUILD antes de instalar.")
            self.content.show_all()
        else:
            labels = {key: label for label, _icon, key in CATEGORIES}
            title = "Todas as aplicações" if self.category == "all" else labels.get(self.category, "Aplicativos")
            self.load_catalog(title, self.category)

    def load_featured(self):
        self.clear()
        self.heading("Bem-vindo à Forja Store")
        self.content.pack_start(
            Gtk.Label(label="Aplicativos dos repositórios oficiais, AUR e Flathub.", xalign=0),
            False, False, 0,
        )
        self.heading("Aplicativos em destaque")
        self.content.pack_start(Gtk.Label(label="Carregando aplicativos disponíveis…", xalign=0), False, False, 0)
        self.content.show_all()
        generation = self.query_generation = self.query_generation + 1
        def worker():
            available, error = package_sources()
            apps = []
            if available is not None:
                apps = [
                    {"name": name, "package": package, "summary": summary, "source": source,
                     "icon": icon, "app_id": "", "version": "", "remote": ""}
                    for name, package, summary, source, icon in FEATURED if package in available
                ]
            GLib.idle_add(self.show_catalog_results, generation, "Aplicativos em destaque", apps, error)
        threading.Thread(target=worker, daemon=True).start()

    def load_catalog(self, title, category):
        self.query_generation += 1
        generation = self.query_generation
        self.clear()
        self.heading(title)
        self.content.pack_start(Gtk.Label(label="Consultando o catálogo de aplicativos…", xalign=0), False, False, 0)
        self.content.show_all()
        def worker():
            available, error = package_sources()
            apps = []
            categories = ALL_APPSTREAM_CATEGORIES if category == "all" else APPSTREAM_CATEGORIES.get(category, [])
            if category != "flatpak" and categories:
                if available is not None:
                    for app_category in categories:
                        result = run(["appstreamcli", "--no-color", "list-categories", app_category], 120)
                        if result.returncode == 0:
                            apps.extend(parse_appstream(result.stdout, available))
                        else:
                            error = result.stderr or result.stdout or "Falha ao consultar o catálogo AppStream."
                else:
                    error = error or "Não foi possível consultar os repositórios Pamac."
            if category in ("all", "flatpak"):
                if shutil.which("flatpak"):
                    flat = run(["flatpak", "remote-ls", "--system", "--app",
                                "--columns=application,name,description,branch", "flathub"], 180)
                    if flat.returncode == 0:
                        apps.extend(parse_flatpak_catalog(flat.stdout))
                    elif category == "flatpak":
                        error = flat.stderr or flat.stdout or "Flathub não está configurado ou não respondeu."
                elif category == "flatpak":
                    error = "Flatpak não está instalado."
            GLib.idle_add(self.show_catalog_results, generation, title, apps, error)
        threading.Thread(target=worker, daemon=True).start()

    def show_catalog_results(self, generation, title, results, error=""):
        if generation != self.query_generation:
            return GLib.SOURCE_REMOVE
        self.clear()
        self.heading(title)
        if results:
            self.add_apps(results)
            self.status.set_text(
                f"{len(results)} aplicativos disponíveis nas fontes consultadas."
                + (f" Aviso: {error}" if error else "")
            )
        else:
            message = error or "Nenhum aplicativo foi encontrado nesta categoria."
            self.content.pack_start(Gtk.Label(label=message, xalign=0, yalign=0, wrap=True), False, False, 0)
            self.status.set_text("O catálogo não retornou aplicativos.")
        self.content.show_all()
        return GLib.SOURCE_REMOVE

    def check_updates(self, *_):
        self.side.select_row(self.category_rows["updates"])
        return GLib.SOURCE_REMOVE

    def load_updates(self, *_):
        self.query_generation += 1
        generation = self.query_generation
        self.clear()
        self.heading("Atualizações disponíveis")
        self.content.pack_start(Gtk.Label(label="Consultando Pamac e Flatpak…", xalign=0), False, False, 0)
        self.content.show_all()
        def worker():
            pac = run(["pamac", "checkupdates", "--aur", "--quiet"], 240)
            aur = subprocess.CompletedProcess([], 0, "", "")
            flat_system = run(["flatpak", "remote-ls", "--updates", "--system", "--app",
                               "--columns=application,name,branch"], 180) if shutil.which("flatpak") else subprocess.CompletedProcess([], 127, "", "flatpak não está instalado")
            flat_user = run(["flatpak", "remote-ls", "--updates", "--user", "--app",
                             "--columns=application,name,branch"], 180) if shutil.which("flatpak") else subprocess.CompletedProcess([], 0, "", "")
            pac_lines, pac_error = update_lines(pac, "Pamac")
            aur_lines, aur_error = update_lines(aur, "AUR")
            flat_lines, flat_error = update_lines(flat_system, "Flatpak")
            user_lines, user_error = update_lines(flat_user, "Flatpak")
            GLib.idle_add(self.show_updates, generation, pac_lines, aur_lines,
                          flat_lines + user_lines, pac_error, aur_error, flat_error or user_error)
        threading.Thread(target=worker, daemon=True).start()

    def show_updates(self, generation, pac, aur, flat, pac_error, aur_error, flat_error):
        if generation != self.query_generation:
            return GLib.SOURCE_REMOVE
        self.clear()
        self.heading("Atualizações disponíveis")
        groups = [("Pamac · repositórios e AUR", pac), ("Flatpak", flat)]
        total = sum(len(items) for _name, items in groups)
        for source, items in groups:
            if items:
                self.heading(source)
                for line in items:
                    label = Gtk.Label(label=line, xalign=0)
                    label.set_selectable(True)
                    self.content.pack_start(label, False, False, 0)
        errors = [name for name, bad in (("Pamac", pac_error or aur_error), ("Flatpak", flat_error)) if bad]
        if errors:
            self.content.pack_start(
                Gtk.Label(label="Não foi possível consultar: " + ", ".join(errors), xalign=0),
                False, False, 0,
            )
        self.content.pack_start(Gtk.Label(label=f"{total} atualização(ões) encontrada(s).", xalign=0), False, False, 0)
        if total:
            button = Gtk.Button(label="Atualizar tudo")
            button.set_halign(Gtk.Align.START)
            button.connect("clicked", self.update_system)
            self.content.pack_start(button, False, False, 0)
        elif not errors:
            self.content.pack_start(Gtk.Label(label="Tudo em dia.", xalign=0), False, False, 0)
        self.status.set_text(f"Pamac: {len(pac)} · Flatpak: {len(flat)}")
        self.content.show_all()
        return GLib.SOURCE_REMOVE

    def add_apps(self, apps):
        self.visible_apps = apps
        self.rendered_count = 0
        self.grid = Gtk.FlowBox()
        self.grid.set_selection_mode(Gtk.SelectionMode.NONE)
        self.grid.set_homogeneous(True)
        self.grid.set_min_children_per_line(2)
        self.grid.set_max_children_per_line(3)
        self.grid.set_column_spacing(14)
        self.grid.set_row_spacing(14)
        self.content.pack_start(self.grid, False, False, 0)
        self.append_more()

    def append_more(self, *_):
        batch = self.visible_apps[self.rendered_count:self.rendered_count + 72]
        for app in batch:
            self.grid.add(self.app_tile(app))
        self.rendered_count += len(batch)
        for child in self.content.get_children():
            if getattr(child, "forja_more_button", False):
                self.content.remove(child)
        if self.rendered_count < len(self.visible_apps):
            more = Gtk.Button(label=f"Mostrar mais aplicativos ({len(self.visible_apps) - self.rendered_count} restantes)")
            more.forja_more_button = True
            more.set_halign(Gtk.Align.CENTER)
            more.connect("clicked", self.append_more)
            self.content.pack_start(more, False, False, 0)
        self.content.show_all()
        return GLib.SOURCE_REMOVE

    def app_tile(self, app):
        name, package, summary = app["name"], app["package"], app["summary"]
        source, icon = app["source"], app["icon"]
        button = Gtk.Button()
        button.get_style_context().add_class("app-tile")
        button.set_relief(Gtk.ReliefStyle.NONE)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.get_style_context().add_class("app-card")
        box.pack_start(Gtk.Image.new_from_icon_name(icon or "application-x-executable", Gtk.IconSize.DIALOG), False, False, 4)
        details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        title = Gtk.Label(label="<b>%s</b>" % GLib.markup_escape_text(name), xalign=0)
        title.set_use_markup(True)
        source_label = {"repo": "Repositório oficial", "aur": "AUR", "flatpak": "Flatpak / " + (app.get("remote") or "Flathub")}[source]
        installed = package in {
            "repo": self.installed_repo,
            "aur": self.installed_aur,
