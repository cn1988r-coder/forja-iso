        }[source]
        details.pack_start(title, False, False, 0)
        details.pack_start(Gtk.Label(label=summary, xalign=0, wrap=True), False, False, 0)
        meta = Gtk.Label(label=source_label + " · " + ("Instalado" if installed else "Disponível"), xalign=0)
        meta.get_style_context().add_class("dim-label")
