import re
import subprocess
import threading
import shutil
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Gio

HELPER = "/usr/lib/forja/forja-pacman-transaction"
ACCENT = "#3584e4"
DARK = "#202124"
SIDEBAR = "#25272b"

