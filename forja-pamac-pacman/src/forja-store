CATEGORIES = [
 ("Início","go-home-symbolic","home"),("Atualizações","software-update-available-symbolic","updates"),
 ("Todas as aplicações","view-grid-symbolic","all"),("Internet","web-browser-symbolic","internet"),
 ("Escritório","x-office-document-symbolic","office"),("Gráficos","applications-graphics-symbolic","graphics"),
 ("Som e vídeo","applications-multimedia-symbolic","multimedia"),("Jogos","applications-games-symbolic","games"),
 ("Sistema","applications-system-symbolic","system")]
FEATURED = [
 ("Firefox","firefox","Navegador web","repo","firefox"),
 ("LibreOffice","libreoffice-fresh","Suíte de produtividade","repo","libreoffice-startcenter"),
 ("VLC","vlc","Reprodução de áudio e vídeo","repo","vlc"),
 ("GIMP","gimp","Edição de imagens","repo","gimp"),
 ("Inkscape","inkscape","Ilustração vetorial","repo","inkscape"),
 ("Audacity","audacity","Edição de áudio","repo","audacity")
]
