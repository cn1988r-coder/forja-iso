def run(args, timeout=90):
    try:
        return subprocess.run(
            args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=timeout, env=None,
        )
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout or ""
        err = exc.stderr or ""
        if isinstance(out, bytes):
            out = out.decode(errors="replace")
        if isinstance(err, bytes):
            err = err.decode(errors="replace")
        return subprocess.CompletedProcess(args, 124, out, err + "\nTempo limite excedido.")
    except OSError as exc:
        return subprocess.CompletedProcess(args, 127, "", str(exc))

def package_sources():
    result = run(["pamac", "list", "--repos", "--quiet"], 120)
    if result.returncode:
        return None, result.stderr or result.stdout or "Falha ao consultar os repositórios Pamac."
    return set(result.stdout.splitlines()), ""

def parse_flatpak_catalog(output):
    rows = []
    for line in output.splitlines():
        if not line.strip():
            continue
        columns = line.rstrip().split("\t") if "\t" in line else re.split(r"\s{2,}", line.strip())
        if len(columns) >= 2:
            rows.append("\t".join(columns[:3] + ["flathub"]))
    return parse_flatpak_search("\n".join(rows))

def update_lines(result, source):
    if source == "Pamac":
        return parse_checkupdates(result)
    if source == "AUR":
        return parse_yay_updates(result)
    return parse_flatpak_updates(result)

class Store(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="br.forja.Store", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.open_updates = False
        self.window = self.content = self.status = self.side = self.search = None
        self.category = "home"
        self.category_rows = {}
        self.installed_repo = set()
        self.installed_aur = set()
        self.installed_flatpak = set()
        self.query_generation = 0
        self.search_timeout = 0
        self.busy = False
        self.visible_apps = []
        self.rendered_count = 0
        self.grid = None

    def do_command_line(self, command_line):
        self.open_updates = "--updates" in command_line.get_arguments()
        self.activate()
        return 0

    def do_activate(self):
        if self.window:
            self.window.present()
            if self.open_updates:
                self.side.select_row(self.category_rows["updates"])
            return
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.window = Gtk.ApplicationWindow(application=self, title="Forja Store")
        self.window.set_default_size(1120, 720)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        title = Gtk.Label(label="<b>Forja Store</b>")
        title.set_use_markup(True)
        header.pack_start(title)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Pesquisar aplicativos em Pamac, AUR e Flathub")
        self.search.set_size_request(390, -1)
        header.set_custom_title(self.search)
        check = Gtk.Button(label="Verificar atualizações")
        check.connect("clicked", self.check_updates)
        header.pack_end(check)
        update = Gtk.Button(label="Atualizar tudo")
        update.connect("clicked", self.update_system)
        header.pack_end(update)
        self.window.set_titlebar(header)

        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.side = Gtk.ListBox()
        self.side.get_style_context().add_class("sidebar")
        self.side.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.side.set_size_request(220, -1)
        for label, icon, key in CATEGORIES:
            row = Gtk.ListBoxRow()
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            line.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
            line.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            row.add(line)
            row.key = key
            self.side.add(row)
            self.category_rows[key] = row
        self.side.connect("row-selected", self.on_category)
        body.pack_start(self.side, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.content.set_margin_start(26)
        self.content.set_margin_end(26)
        self.content.set_margin_top(22)
        self.content.set_margin_bottom(22)
        scroll.add(self.content)
        body.pack_start(scroll, True, True, 0)
        root.pack_start(body, True, True, 0)
        self.status = Gtk.Label(label="Preparando a loja…", xalign=0)
        self.status.get_style_context().add_class("statusbar")
        root.pack_start(self.status, False, False, 0)
        self.window.add(root)
        self.search.connect("search-changed", self.on_search)
