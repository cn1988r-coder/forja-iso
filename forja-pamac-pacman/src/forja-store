def run(args, timeout=90):
    try:
        return subprocess.run(args,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=timeout)
    except (OSError,subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(args,1,str(exc))

def parse_search(output, source):
    found=[]; current=None
    for line in output.splitlines():
        if line and not line[0].isspace():
            match=re.match(r"^(?:[^/]+/)?([^ ]+) ([^ ]+)",line)
            if match:
                current=(match.group(1),match.group(1),"Pacote disponível",source,"application-x-executable")
                found.append(current)
        elif current and line.strip():
            found[-1]=(current[0],current[1],line.strip(),source,current[4]); current=None
    return found

def parse_appstream(output):
    found=[]
    for block in re.split(r"(?m)(?=^Identifier:\s)",output):
        fields={}
        for line in block.splitlines():
            if ": " in line:
                key,value=line.split(": ",1)
                fields.setdefault(key.strip(),value.strip())
        identifier=fields.get("Identifier","")
        if "[desktop-application]" not in identifier:
            continue
        package=fields.get("Package","").split(",")[0].strip()
        bundle=fields.get("Bundle","")
        if package:
            found.append((fields.get("Name",package),package,fields.get("Summary","Aplicativo disponível"),"repo",fields.get("Icon","application-x-executable").split(":",1)[-1].removesuffix(".png").removesuffix(".svg")))
        elif bundle.startswith("flatpak:app/"):
            parts=bundle.split("/")
            if len(parts)>=2:
                found.append((fields.get("Name",parts[1]),parts[1],fields.get("Summary","Aplicativo Flatpak"),"flatpak",fields.get("Icon","application-x-executable").split(":",1)[-1].removesuffix(".png").removesuffix(".svg")) )
    return found

class Store(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="br.forja.Store",flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.open_updates=False; self.window=None; self.content=None; self.status=None
        self.side=None; self.search=None; self.category="home"; self.category_rows={}
        self.installed_repo=set(); self.installed_aur=set(); self.installed_flatpak=set()
        self.query_generation=0; self.busy=False

    def do_command_line(self,command_line):
        self.open_updates="--updates" in command_line.get_arguments(); self.activate(); return 0

    def do_activate(self):
        if self.window:
            self.window.present()
            if self.open_updates: self.side.select_row(self.category_rows["updates"])
            return
        provider=Gtk.CssProvider(); provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),provider,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.window=Gtk.ApplicationWindow(application=self,title="Forja Store"); self.window.set_default_size(1120,720)
        root=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=0)
        header=Gtk.HeaderBar(); header.set_show_close_button(True)
        title=Gtk.Label(label="<b>Forja Store</b>"); title.set_use_markup(True); header.pack_start(title)
        self.search=Gtk.SearchEntry(); self.search.set_placeholder_text("Pesquisar em Pacman, AUR e Flatpak")
        self.search.set_size_request(390,-1); header.set_custom_title(self.search)
        check=Gtk.Button(label="Verificar atualizações"); check.connect("clicked",self.check_updates); header.pack_end(check)
        update=Gtk.Button(label="Atualizar tudo"); update.get_style_context().add_class("suggested-action")
        update.connect("clicked",self.update_system); header.pack_end(update); self.window.set_titlebar(header)
        body=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=0)
        self.side=Gtk.ListBox(); self.side.get_style_context().add_class("sidebar")
        self.side.set_selection_mode(Gtk.SelectionMode.SINGLE); self.side.set_size_request(220,-1)
        for label,icon,key in CATEGORIES:
            row=Gtk.ListBoxRow(); line=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=12)
            line.pack_start(Gtk.Image.new_from_icon_name(icon,Gtk.IconSize.LARGE_TOOLBAR),False,False,0)
            line.pack_start(Gtk.Label(label=label,xalign=0),True,True,0); row.add(line); row.key=key
            self.side.add(row); self.category_rows[key]=row
        self.side.connect("row-selected",self.on_category); body.pack_start(self.side,False,False,0)
        scroll=Gtk.ScrolledWindow(); scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC)
        self.content=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=16)
        for method in (self.content.set_margin_start,self.content.set_margin_end): method(26)
        self.content.set_margin_top(22); self.content.set_margin_bottom(22); scroll.add(self.content)
        body.pack_start(scroll,True,True,0); root.pack_start(body,True,True,0)
        self.status=Gtk.Label(label="Carregando aplicativos…",xalign=0); self.status.get_style_context().add_class("statusbar")
        root.pack_start(self.status,False,False,0); self.window.add(root)
        self.search.connect("search-changed",self.on_search); self.side.select_row(self.category_rows["home"])
        self.window.show_all()
        if self.open_updates: self.side.select_row(self.category_rows["updates"])
        self.reload_installed()

    def clear(self):
        for child in self.content.get_children(): self.content.remove(child)

    def heading(self,text):
        label=Gtk.Label(label=text,xalign=0); label.get_style_context().add_class("section-title")
        self.content.pack_start(label,False,False,0)

    def on_category(self,_list,row):
        if row:
            self.category=row.key; self.search.set_text(""); self.show_category()

    def on_search(self,*_):
        query=self.search.get_text().strip()
        if query: self.category="search"; self.search_packages(query)

    def reload_installed(self):
        def worker():
            # -Qn lista pacotes nativos presentes nas bases sincronizadas;
            # -Qm lista pacotes estrangeiros (AUR ou instalação local manual).
            repo=run(["pacman","-Qnq"],60); foreign=run(["pacman","-Qmq"],60)
            flat=run(["flatpak","list","--app","--columns=application"],60) if shutil.which("flatpak") else None
            GLib.idle_add(self.set_installed,
                set(repo.stdout.splitlines()) if repo.returncode==0 else set(),
                set(foreign.stdout.splitlines()) if foreign.returncode==0 else set(),
                set(flat.stdout.splitlines()) if flat and flat.returncode==0 else set())
        threading.Thread(target=worker,daemon=True).start()

    def set_installed(self,repo,aur,flat):
        self.installed_repo=repo; self.installed_aur=aur; self.installed_flatpak=flat
        if self.category not in ("search","updates"): self.show_category()
        return GLib.SOURCE_REMOVE

    def show_category(self):
        if self.category=="home":
            self.clear()
            self.heading("Bem-vindo à Forja Store")
            self.content.pack_start(Gtk.Label(label="Aplicativos dos repositórios oficiais, AUR e Flathub.",xalign=0),False,False,0)
            self.heading("Aplicativos em destaque"); self.add_apps(FEATURED)
            self.content.show_all()
        elif self.category=="updates":
            self.load_updates()
        else:
            labels={k:v for v,_i,k in CATEGORIES}
            title="Todas as aplicações" if self.category=="all" else labels.get(self.category,"Aplicativos")
            self.load_catalog(title,self.category)

    def load_catalog(self,title,category):
        self.query_generation+=1; generation=self.query_generation
        self.clear(); self.heading(title)
        self.content.pack_start(Gtk.Label(label="Carregando catálogo de aplicativos…",xalign=0),False,False,0)
        self.content.show_all()
        def worker():
            results=[]
            categories=ALL_APPSTREAM_CATEGORIES if category=="all" else APPSTREAM_CATEGORIES.get(category,[])
            for app_category in categories:
                result=run(["appstreamcli","--details","list-categories",app_category],90)
                if result.returncode==0:
                    results.extend(parse_appstream(result.stdout))
            unique=[]; seen=set()
            for item in results:
                key=(item[1],item[3])
                if key not in seen:
                    seen.add(key); unique.append(item)
            unique.sort(key=lambda item:item[0].casefold())
            apps=unique
            GLib.idle_add(self.show_catalog_results,generation,title,apps)
        threading.Thread(target=worker,daemon=True).start()

    def show_catalog_results(self,generation,title,results):
        if generation!=self.query_generation: return GLib.SOURCE_REMOVE
        self.clear(); self.heading(title)
        if results:
            self.add_apps(results)
            self.status.set_text(f"{len(results)} aplicativos encontrados no catálogo AppStream.")
        else:
            self.content.pack_start(Gtk.Label(label="Catálogo AppStream indisponível ou sem aplicativos nesta categoria. Atualize os bancos de pacotes e tente novamente.",xalign=0),False,False,0)
            self.status.set_text("Não foi possível carregar o catálogo AppStream.")
        self.content.show_all(); return GLib.SOURCE_REMOVE

    def check_updates(self,*_):
        self.side.select_row(self.category_rows["updates"]); return GLib.SOURCE_REMOVE

    def load_updates(self,*_):
        self.clear(); self.heading("Atualizações disponíveis")
        loading=Gtk.Label(label="Consultando Pacman, AUR e Flatpak…",xalign=0)
        self.content.pack_start(loading,False,False,0); self.content.show_all()
        def worker():
            pac=run(["checkupdates"],180)
            aur=run(["yay","-Qua"],240) if shutil.which("yay") else subprocess.CompletedProcess([],127,"yay não instalado")
            flat=run(["flatpak","remote-ls","--system","--updates","--columns=application,name,branch"],180) if shutil.which("flatpak") else subprocess.CompletedProcess([],127,"flatpak não instalado")
            userflat=run(["flatpak","remote-ls","--user","--updates","--columns=application,name,branch"],180) if shutil.which("flatpak") else subprocess.CompletedProcess([],0,"")
            GLib.idle_add(self.show_updates,
                [x for x in pac.stdout.splitlines() if x.strip()] if pac.returncode in (0,2) else [],
                [x for x in aur.stdout.splitlines() if x.strip()] if aur.returncode in (0,1) else [],
                [x for x in (flat.stdout+"\n"+userflat.stdout).splitlines() if x.strip()],
                pac.returncode not in (0,2), aur.returncode not in (0,1),
                flat.returncode not in (0,1) or userflat.returncode not in (0,1))
        threading.Thread(target=worker,daemon=True).start()

    def show_updates(self,pac,aur,flat,pac_error,aur_error,flat_error):
        self.clear(); self.heading("Atualizações disponíveis")
        groups=[("Pacman",pac),("AUR",aur),("Flatpak",flat)]
        total=sum(len(items) for _name,items in groups)
        for source,items in groups:
            if items:
                self.heading(source)
                for line in items:
                    label=Gtk.Label(label=line,xalign=0); label.set_selectable(True)
                    self.content.pack_start(label,False,False,0)
        errors=[name for name,bad in (("Pacman",pac_error),("AUR",aur_error),("Flatpak",flat_error)) if bad]
        if errors:
            self.content.pack_start(Gtk.Label(label="Falha ao consultar: "+", ".join(errors),xalign=0),False,False,0)
        self.content.pack_start(Gtk.Label(label=f"{total} atualização(ões) encontrada(s).",xalign=0),False,False,0)
        if total:
            button=Gtk.Button(label="Atualizar tudo (Pacman + AUR + Flatpak)"); button.get_style_context().add_class("suggested-action")
            button.set_halign(Gtk.Align.START); button.connect("clicked",self.update_system)
            self.content.pack_start(button,False,False,0)
        elif not errors:
            self.content.pack_start(Gtk.Label(label="Tudo em dia.",xalign=0),False,False,0)
        self.status.set_text(f"Atualização conjunta · Pacman: {len(pac)} · AUR: {len(aur)} · Flatpak: {len(flat)}")
        self.content.show_all(); return GLib.SOURCE_REMOVE

    def add_apps(self,apps):
        grid=Gtk.FlowBox(); grid.set_selection_mode(Gtk.SelectionMode.NONE); grid.set_homogeneous(True)
        grid.set_min_children_per_line(2); grid.set_max_children_per_line(3)
        grid.set_column_spacing(14); grid.set_row_spacing(14)
        for name,package,summary,source,icon in apps: grid.add(self.app_tile(name,package,summary,source,icon))
        self.content.pack_start(grid,False,False,0)

    def app_tile(self,name,package,summary,source,icon):
        button=Gtk.Button(); button.set_relief(Gtk.ReliefStyle.NONE)
        box=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=12); box.get_style_context().add_class("app-card")
        box.pack_start(Gtk.Image.new_from_icon_name(icon or "application-x-executable",Gtk.IconSize.DIALOG),False,False,4)
        details=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=5)
        title=Gtk.Label(label="<b>%s</b>"%GLib.markup_escape_text(name),xalign=0); title.set_use_markup(True)
        source_label={"repo":"Repositório oficial","aur":"AUR / pacote externo","flatpak":"Flatpak"}[source]
        installed=package in {"repo":self.installed_repo,"aur":self.installed_aur,"flatpak":self.installed_flatpak}[source]
        details.pack_start(title,False,False,0)
        details.pack_start(Gtk.Label(label=summary,xalign=0),False,False,0)
        meta=Gtk.Label(label=source_label+" · "+("Instalado" if installed else "Disponível"),xalign=0)
        meta.get_style_context().add_class("dim-label"); details.pack_start(meta,False,False,0)
        box.pack_start(details,True,True,0); button.add(box)
        button.connect("clicked",self.show_details,name,package,summary,source); return button

    def search_packages(self,query):
        self.query_generation+=1; generation=self.query_generation
        self.clear(); self.heading("Resultados da pesquisa")
        self.content.pack_start(Gtk.Label(label="Pesquisando no catálogo, Pacman, AUR e Flatpak…",xalign=0),False,False,0); self.content.show_all()
        def worker():
            results=[]
            catalog=run(["appstreamcli","--details","search",query],90) if shutil.which("appstreamcli") else subprocess.CompletedProcess([],127,"")
            if catalog.returncode==0: results.extend(parse_appstream(catalog.stdout))
            repo=run(["pacman","-Ss",query],90)
            if repo.returncode in (0,1): results.extend(parse_search(repo.stdout,"repo"))
            if shutil.which("yay"):
                aur=run(["yay","-Ssa",query],120)
                if aur.returncode in (0,1): results.extend(parse_search(aur.stdout,"aur"))
            if shutil.which("flatpak"):
                fp=run(["flatpak","search","--columns=application,name,description,remotes",query],120)
                if fp.returncode in (0,1):
                    for line in fp.stdout.splitlines():
                        cols=line.split("\t")
                        if len(cols)>=2 and "." in cols[0]:
                            results.append((cols[1],cols[0],cols[2] if len(cols)>2 else cols[1],"flatpak","application-x-executable"))
            unique=[]; seen=set()
            for item in results:
                key=(item[1],item[3])
                if key not in seen: seen.add(key); unique.append(item)
            GLib.idle_add(self.show_search_results,generation,unique[:120])
        threading.Thread(target=worker,daemon=True).start()

    def show_search_results(self,generation,results):
        if generation!=self.query_generation: return GLib.SOURCE_REMOVE
        self.clear(); self.heading("Resultados da pesquisa")
        if results: self.add_apps(results)
        else: self.content.pack_start(Gtk.Label(label="Nenhum resultado encontrado ou fontes indisponíveis.",xalign=0),False,False,0)
        self.status.set_text(f"{len(results)} resultado(s) em AppStream, Pacman, AUR e Flatpak.")
        self.content.show_all(); return GLib.SOURCE_REMOVE

    def show_details(self,_button,name,package,summary,source):
        installed=package in {"repo":self.installed_repo,"aur":self.installed_aur,"flatpak":self.installed_flatpak}[source]
        dialog=Gtk.Dialog(title=name,transient_for=self.window,flags=Gtk.DialogFlags.MODAL)
        dialog.add_button("Fechar",Gtk.ResponseType.CLOSE)
        action=dialog.add_button("Remover" if installed else "Instalar",Gtk.ResponseType.ACCEPT)
        action.get_style_context().add_class("suggested-action")
        area=dialog.get_content_area(); area.set_spacing(10); area.set_margin_start(22); area.set_margin_end(22)
        area.set_margin_top(18); area.set_margin_bottom(18)
        for text in (summary,{"repo":"Origem: repositórios oficiais Manjaro/Pacman","aur":"Origem: AUR (pacotes instalados fora dos repositórios oficiais são classificados como externos)","flatpak":"Origem: Flathub/Flatpak"}[source]):
            area.pack_start(Gtk.Label(label=text,xalign=0),False,False,0)
        dialog.show_all(); response=dialog.run(); dialog.destroy()
        if response==Gtk.ResponseType.ACCEPT: self.transact("remove" if installed else "install",source,package)

    def transact(self,action,source,name):
        if self.busy:
            self.status.set_text("Aguarde a operação atual terminar antes de iniciar outra.")
            return
        self.busy=True
        self.status.set_text(f"Executando {action} · {source} · {name}…")
        def worker():
            result=run(["pkexec",HELPER,action,source,name],7200)
            GLib.idle_add(self.operation_done,result.returncode,name,action,source)
        threading.Thread(target=worker,daemon=True).start()

    def operation_done(self,code,name,action,source):
        self.busy=False
        self.status.set_text(("Concluído: " if code==0 else "Falhou ou foi cancelado: ")+name)
        if code==0: self.reload_installed()
        return GLib.SOURCE_REMOVE

    def update_system(self,*_):
        if self.busy: return
        self.busy=True; self.status.set_text("Atualizando repositórios, AUR e Flatpak…")
        def worker():
            system=run(["pkexec",HELPER,"upgrade"],7200)
            userflat=run(["flatpak","update","--user","--noninteractive","--assumeyes"],7200) if system.returncode==0 and shutil.which("flatpak") else subprocess.CompletedProcess([],0,"")
            code=system.returncode or userflat.returncode
            GLib.idle_add(self.update_done,code)
        threading.Thread(target=worker,daemon=True).start()

    def update_done(self,code):
        self.busy=False; self.status.set_text("Atualização concluída." if code==0 else "Atualização falhou ou foi cancelada.")
        self.reload_installed(); self.load_updates(); return GLib.SOURCE_REMOVE

if __name__=="__main__":
    raise SystemExit(Store().run(None))
