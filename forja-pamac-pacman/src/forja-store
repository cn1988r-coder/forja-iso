    def search_packages(self, query):
        self.query_generation += 1
        generation = self.query_generation
        self.clear()
        self.heading("Resultados da pesquisa")
        self.content.pack_start(Gtk.Label(label="Pesquisando em AppStream, Pamac, AUR e Flathub…", xalign=0), False, False, 0)
        self.content.show_all()
        def worker():
            results = []
            errors = []
            available, package_error = package_sources()
            catalog = run(["appstreamcli", "--no-color", "search", query], 120) if shutil.which("appstreamcli") else subprocess.CompletedProcess([], 127, "", "appstreamcli ausente")
            if available is not None and catalog.returncode == 0:
                results.extend(parse_appstream(catalog.stdout, available))
            else:
                errors.append("AppStream")
            if available is not None:
                repo = run(["pamac", "search", "--no-aur", query], 120)
                if repo.returncode in (0, 1):
                    results.extend(parse_pacman_search(repo.stdout, "repo"))
                else:
                    errors.append("Pamac")
            else:
                errors.append("Pamac")
            if shutil.which("pamac"):
                aur = run(["pamac", "search", "--aur", query], 180)
                if aur.returncode in (0, 1):
                    results.extend(parse_pacman_search(aur.stdout, "aur"))
                else:
                    errors.append("AUR")
            else:
                errors.append("AUR")
            if shutil.which("flatpak"):
                fp = run(["flatpak", "search", "--system",
                          "--columns=application,name,description,remotes", query], 180)
                if fp.returncode == 0:
                    results.extend(parse_flatpak_search(fp.stdout))
                else:
                    errors.append("Flatpak")
            else:
                errors.append("Flatpak")
            GLib.idle_add(self.show_search_results, generation, results, errors)
        threading.Thread(target=worker, daemon=True).start()

    def show_search_results(self, generation, results, errors):
        if generation != self.query_generation:
            return GLib.SOURCE_REMOVE
        self.clear()
        self.heading("Resultados da pesquisa")
        if results:
            self.add_apps(results[:600])
        else:
            message = "Nenhum aplicativo encontrado."
            if errors:
                message += " Fontes com falha: " + ", ".join(errors) + "."
            self.content.pack_start(Gtk.Label(label=message, xalign=0, wrap=True), False, False, 0)
        self.status.set_text(
            f"{len(results)} resultado(s)" + (". Fontes com falha: " + ", ".join(errors) if errors else ".")
        )
        self.content.show_all()
        return GLib.SOURCE_REMOVE

