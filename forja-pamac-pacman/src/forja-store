        package = app["package"]
        installed = package in {
            "repo": self.installed_repo,
            "aur": self.installed_aur,
            "flatpak": self.installed_flatpak,
        }[source]
        dialog = Gtk.Dialog(title=app["name"], transient_for=self.window, flags=Gtk.DialogFlags.MODAL)
        dialog.add_button("Fechar", Gtk.ResponseType.CLOSE)
        action = dialog.add_button("Remover" if installed else "Instalar", Gtk.ResponseType.ACCEPT)
        area = dialog.get_content_area()
        area.set_spacing(10)
        area.set_margin_start(22)
        area.set_margin_end(22)
        area.set_margin_top(18)
        area.set_margin_bottom(18)
        area.pack_start(Gtk.Label(label=app["summary"], xalign=0, yalign=0, wrap=True), False, False, 0)
        labels = {
            "repo": "Origem: repositórios oficiais Manjaro / Pamac",
            "aur": "Origem: Arch User Repository. Pacotes comunitários não são verificados oficialmente pelo Manjaro.",
            "flatpak": "Origem: Flatpak / " + (app.get("remote") or "Flathub"),
        }
        area.pack_start(Gtk.Label(label=labels[source], xalign=0, wrap=True), False, False, 0)
        if source == "aur":
            area.pack_start(
                Gtk.Label(label="Atenção: pacotes do AUR são enviados pela comunidade e não são auditados pela Forja OS. Revise o PKGBUILD e a origem antes de instalar.", xalign=0, yalign=0, wrap=True),
                False, False, 0,
            )
            link = Gtk.LinkButton.new_with_label(
                "https://aur.archlinux.org/packages/" + package,
                "Abrir pacote no AUR e revisar o PKGBUILD",
            )
            area.pack_start(link, False, False, 0)
        area.pack_start(Gtk.Label(label="Pacote: " + package, xalign=0), False, False, 0)
        if app.get("version"):
            area.pack_start(Gtk.Label(label="Versão do catálogo: " + app["version"], xalign=0), False, False, 0)
        if app.get("app_id") and app["app_id"] != package:
            area.pack_start(Gtk.Label(label="ID AppStream: " + app["app_id"], xalign=0), False, False, 0)
        dialog.show_all()
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.ACCEPT:
            self.transact("remove" if installed else "install", source, package, app.get("remote", ""))

    def show_result_dialog(self, title, code, output):
        kind = Gtk.MessageType.INFO if code == 0 else Gtk.MessageType.ERROR
        dialog = Gtk.MessageDialog(
            transient_for=self.window, flags=Gtk.DialogFlags.MODAL,
            message_type=kind, buttons=Gtk.ButtonsType.CLOSE,
            text=title,
        )
        details = (output or "").strip()
        if details:
            dialog.format_secondary_text(details[-5000:])
        dialog.run()
        dialog.destroy()

    def transact(self, action, source, name, remote=""):
        if self.busy:
            self.status.set_text("Aguarde a operação atual terminar antes de iniciar outra.")
            return
        self.busy = True
        self.status.set_text(f"Executando {action} · {source} · {name}…")
        def worker():
            args = [HELPER, action, source, name]
            if source == "flatpak":
                args.append(remote or "flathub")
            result = run(args, 7200)
            GLib.idle_add(self.operation_done, result.returncode, name, action, source,
                          result.stdout + ("\n" + result.stderr if result.stderr else ""))
        threading.Thread(target=worker, daemon=True).start()

    def operation_done(self, code, name, action, source, output):
        self.busy = False
        if code == 0:
            self.status.set_text(f"Concluído: {name}")
            self.show_result_dialog("Operação concluída", code, output or f"{name}: operação concluída.")
            self.reload_installed()
        else:
            self.status.set_text(f"Falhou ou foi cancelado: {name}")
            self.show_result_dialog("Não foi possível concluir a operação", code, output or "A operação foi cancelada ou retornou erro sem mensagem.")
        return GLib.SOURCE_REMOVE

    def update_system(self, *_):
        if self.busy:
            return
        self.busy = True
        self.status.set_text("Atualizando Pamac e Flatpak…")
        def worker():
            system = run([HELPER, "upgrade"], 7200)
            userflat = run(["flatpak", "update", "--user", "--noninteractive", "--assumeyes"], 7200) if shutil.which("flatpak") else subprocess.CompletedProcess([], 127, "", "flatpak não instalado")
            code = system.returncode or userflat.returncode
            output = system.stdout + ("\n" + system.stderr if system.stderr else "")
            output += "\nAtualização Flatpak do usuário:\n" + userflat.stdout + ("\n" + userflat.stderr if userflat.stderr else "")
            GLib.idle_add(self.update_done, code, output)
        threading.Thread(target=worker, daemon=True).start()

    def update_done(self, code, output):
        self.busy = False
        self.status.set_text("Atualização concluída." if code == 0 else "Uma ou mais atualizações falharam.")
        self.show_result_dialog("Atualização concluída" if code == 0 else "Falha na atualização", code, output)
        self.reload_installed()
        self.load_updates()
        return GLib.SOURCE_REMOVE

if __name__ == "__main__":
    raise SystemExit(Store().run(None))
