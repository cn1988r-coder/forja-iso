diff --git a/.github/workflows/build-manjaro.yml b/.github/workflows/build-manjaro.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/build-manjaro.yml
@@ -0,0 +1,52 @@
+name: Build Manjaro ISO
+
+on:
+  workflow_dispatch:
+    inputs:
+      desktop:
+        description: Ambiente gráfico
+        required: true
+        type: choice
+        options:
+          - mate
+          - xfce
+          - gnome
+          - kde
+        default: mate
+      kernel:
+        description: Kernel
+        required: true
+        type: choice
+        options:
+          - lts
+          - latest
+        default: lts
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    timeout-minutes: 360
+    steps:
+      - name: Baixar repositório
+        uses: actions/checkout@v4
+
+      - name: Preparar diretório de saída
+        run: mkdir -p "${{ github.workspace }}/output"
+
+      - name: Baixar imagem base Manjaro
+        run: docker pull manjarolinux/base:latest
+
+      - name: Compilar ISO
+        env:
+          DESKTOP: ${{ inputs.desktop }}
+          KERNEL: ${{ inputs.kernel }}
+        run: |
+          docker run --rm --privileged --network host \
+            --security-opt seccomp=unconfined \
+            -v "${{ github.workspace }}:/forja-ci" \
+            -v "${{ github.workspace }}/output:/forja-output" \
+            -e FORJA_DESKTOP="$DESKTOP" \
+            -e FORJA_KERNEL="$KERNEL" \
+            -e FORJA_OUTPUT=/forja-output \
+            manjarolinux/base:latest \
+            bash /forja-ci/ci/build-cloud.sh
+
+      - name: Publicar ISO e checksums
+        if: success()
+        uses: actions/upload-artifact@v4
+        with:
+          name: forja-manjaro-${{ inputs.desktop }}-${{ inputs.kernel }}
+          path: |
+            output/*.iso
+            output/*.sha256
+            output/build-info.txt
+          if-no-files-found: error
+          retention-days: 7
+          compression-level: 0
