linux-headers
sudo
nano
git
networkmanager
wireless-regdb
wpa_supplicant
bluez
bluez-utils
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
alsa-utils
pavucontrol
udisks2
udisks2-btrfs
btrfs-progs
dosfstools
e2fsprogs
xfsprogs
ntfs-3g
lvm2
efibootmgr
grub
os-prober

# XFCE desktop
xfce4
xfce4-goodies
xfce4-whiskermenu-plugin
xfce4-docklike-plugin
xfce4-genmon-plugin
xfce4-clipman-plugin
xfce4-pulseaudio-plugin
xfce4-power-manager
xfce4-notifyd
