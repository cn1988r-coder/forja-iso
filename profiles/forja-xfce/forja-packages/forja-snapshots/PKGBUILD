pkgname=forja-snapshots
pkgver=0.2.0
pkgrel=1
pkgdesc="Snapshots Btrfs com Timeshift e integracao GRUB-Btrfs do Forja OS"
arch=('any')
url="https://github.com/cn1988r-coder/forja-iso"
license=('GPL-3.0-or-later')
depends=('bash' 'btrfs-progs' 'timeshift' 'grub' 'grub-btrfs' 'inotify-tools' 'util-linux')
source=('forja-snapshot-setup' 'forja-pacman-snapshot' 'forja-snapshot-pre.hook' 'forja-snapshot-setup.service' 'forja-timeshift-check.service' 'forja-timeshift-check.timer')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/forja-snapshot-setup" "$pkgdir/usr/bin/forja-snapshot-setup"
  install -Dm755 "$srcdir/forja-pacman-snapshot" "$pkgdir/usr/bin/forja-pacman-snapshot"
  install -Dm644 "$srcdir/forja-snapshot-pre.hook" "$pkgdir/usr/share/libalpm/hooks/forja-snapshot-pre.hook"
  install -Dm644 "$srcdir/forja-snapshot-setup.service" "$pkgdir/usr/lib/systemd/system/forja-snapshot-setup.service"
  install -Dm644 "$srcdir/forja-timeshift-check.service" "$pkgdir/usr/lib/systemd/system/forja-timeshift-check.service"
  install -Dm644 "$srcdir/forja-timeshift-check.timer" "$pkgdir/usr/lib/systemd/system/forja-timeshift-check.timer"
  install -d "$pkgdir/etc/systemd/system/multi-user.target.wants"
  ln -s /usr/lib/systemd/system/forja-snapshot-setup.service "$pkgdir/etc/systemd/system/multi-user.target.wants/forja-snapshot-setup.service"
  ln -s /usr/lib/systemd/system/forja-timeshift-check.timer "$pkgdir/etc/systemd/system/timers.target.wants/forja-timeshift-check.timer"
}
