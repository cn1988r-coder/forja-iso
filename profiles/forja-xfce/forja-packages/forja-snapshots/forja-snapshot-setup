#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${FORJA_SNAPSHOT_ROOT:-/}"
GRUB_MKCONFIG="${GRUB_MKCONFIG:-/usr/bin/grub-mkconfig}"
log() { printf '[forja-snapshot-setup] %s\n' "$*"; }
die() { log "ERRO: $*" >&2; exit 1; }

[[ "$EUID" -eq 0 ]] || die "execute como root."
command -v findmnt >/dev/null || die "findmnt não encontrado."
command -v snapper >/dev/null || die "snapper não encontrado."
command -v btrfs >/dev/null || die "btrfs-progs não encontrado."
[[ -d "$ROOT" ]] || die "raiz de destino inexistente: $ROOT"

root_fs="$(findmnt -n -o FSTYPE "$ROOT" 2>/dev/null || true)"
if [[ "$root_fs" != "btrfs" ]]; then
  log "Raiz não é Btrfs (tipo: ${root_fs:-desconhecido}); ignorando ambiente Live."
  exit 0
fi
root_source="$(findmnt -n -o SOURCE "$ROOT")"
log "Raiz Btrfs detectada: $root_source"

SNAPPER=(snapper -c root)
if [[ "$ROOT" != "/" ]]; then
  SNAPPER+=(--root "$ROOT")
fi

if ! "${SNAPPER[@]}" get-config >/dev/null 2>&1; then
  [[ ! -e "$ROOT/.snapshots" || -d "$ROOT/.snapshots" ]] || die "$ROOT/.snapshots existe e não é um diretório."
  if mountpoint -q "$ROOT/.snapshots"; then
    die "$ROOT/.snapshots já é um ponto de montagem. Verifique o layout antes de continuar."
  fi
  rmdir "$ROOT/.snapshots" 2>/dev/null || true
  "${SNAPPER[@]}" create-config /
fi

config="$ROOT/etc/snapper/configs/root"
[[ -s "$config" ]] || die "configuração Snapper root não foi criada."
set_config() {
  local key="$1" value="$2"
  if grep -qE "^#?[[:space:]]*${key}=" "$config"; then
    sed -i -E "s|^#?[[:space:]]*${key}=.*|${key}=${value}|" "$config"
  else
    printf '%s=%s\n' "$key" "$value" >> "$config"
  fi
}
set_config SUBVOLUME '"/"'
set_config FSTYPE '"btrfs"'
set_config TIMELINE_CREATE '"yes"'
set_config TIMELINE_CLEANUP '"yes"'
set_config NUMBER_CLEANUP '"yes"'
set_config NUMBER_LIMIT '"10"'
set_config NUMBER_LIMIT_IMPORTANT '"5"'
set_config TIMELINE_LIMIT_HOURLY '"5"'
set_config TIMELINE_LIMIT_DAILY '"7"'
set_config TIMELINE_LIMIT_WEEKLY '"4"'
set_config TIMELINE_LIMIT_MONTHLY '"3"'
set_config TIMELINE_LIMIT_YEARLY '"0"'

if [[ "$ROOT" == "/" ]]; then
  systemctl enable snapper-timeline.timer snapper-cleanup.timer
else
  systemctl --root="$ROOT" enable snapper-timeline.timer snapper-cleanup.timer
fi

if ! "${SNAPPER[@]}" list --columns number | awk '$1 ~ /^[0-9]+$/ { found=1 } END { exit !found }'; then
  "${SNAPPER[@]}" create --description "Forja: instalação inicial"
fi

grub_service="$ROOT/usr/lib/systemd/system/grub-btrfsd.service"
[[ -s "$grub_service" ]] || grub_service="$ROOT/lib/systemd/system/grub-btrfsd.service"
[[ -s "$grub_service" ]] || die "grub-btrfsd.service não foi encontrado no sistema de destino."
if [[ "$ROOT" == "/" ]]; then
  systemctl enable grub-btrfsd.service
else
  systemctl --root="$ROOT" enable grub-btrfsd.service
fi

[[ -x "$GRUB_MKCONFIG" && -d "$ROOT/boot/grub" ]] || die "GRUB não está instalado ou /boot/grub não existe."
"$GRUB_MKCONFIG" -o "$ROOT/boot/grub/grub.cfg"
"${SNAPPER[@]}" list >/dev/null
log "Snapper configurado, timers ativados e menu GRUB atualizado."
