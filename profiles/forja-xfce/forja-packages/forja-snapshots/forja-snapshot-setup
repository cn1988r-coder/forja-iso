#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${FORJA_SNAPSHOT_ROOT:-/}"
GRUB_MKCONFIG="${GRUB_MKCONFIG:-/usr/bin/grub-mkconfig}"
log() { printf '[forja-snapshot-setup] %s\n' "$*"; }
die() { log "ERRO: $*" >&2; exit 1; }

[[ "$EUID" -eq 0 ]] || die "execute como root."
command -v findmnt >/dev/null || die "findmnt não encontrado."
command -v timeshift >/dev/null || die "Timeshift não encontrado."
command -v btrfs >/dev/null || die "btrfs-progs não encontrado."
[[ -d "$ROOT" ]] || die "raiz de destino inexistente: $ROOT"

root_fs="$(findmnt -n -o FSTYPE "$ROOT" 2>/dev/null || true)"
if [[ "$root_fs" != "btrfs" ]]; then
  log "Raiz não é Btrfs (tipo: ${root_fs:-desconhecido}); ignorando ambiente Live."
  exit 0
fi

if [[ "$ROOT" != "/" ]]; then
  die "A configuração do Timeshift deve ser executada no primeiro boot do sistema instalado, não em um rootfs montado externamente."
fi

root_subvol="$(findmnt -n -o FSROOT /)"
[[ "$root_subvol" == "/@" ]] || die "Layout incompatível com Timeshift: raiz atual em '$root_subvol'; esperado /@."
root_uuid="$(findmnt -n -o UUID -T /)"
[[ -n "$root_uuid" ]] || die "Não foi possível identificar o UUID do volume Btrfs."

fstab_root="$(awk '!/^[[:space:]]*#/ && $2=="/" {print $4; exit}' /etc/fstab)"
[[ -n "$fstab_root" ]] || die "Entrada da raiz ausente em /etc/fstab."
if grep -Eq '(^|,)subvolid=' <<<"$fstab_root"; then
  die "Remova subvolid= da entrada / em /etc/fstab; Timeshift precisa que o subvolume @ possa ser trocado."
fi
grep -Eq '(^|,)subvol=@(,|$)' <<<"$fstab_root" || die "A entrada / em /etc/fstab deve montar subvol=@."

install -d -m755 /etc/timeshift
cat > /etc/timeshift/timeshift.json <<EOF
{
  "backup_device_uuid": "$root_uuid",
  "parent_device_uuid": "",
  "do_first_run": "false",
  "btrfs_mode": "true",
  "include_btrfs_home": "false",
  "stop_cron_emails": "true",
  "schedule_monthly": "false",
  "schedule_weekly": "true",
  "schedule_daily": "true",
  "schedule_hourly": "false",
  "schedule_boot": "true",
  "count_monthly": "2",
  "count_weekly": "3",
  "count_daily": "5",
  "count_hourly": "6",
  "count_boot": "3",
  "snapshot_size": "0",
  "snapshot_count": "0",
  "exclude": [],
  "exclude-apps": []
}
EOF
chmod 600 /etc/timeshift/timeshift.json

timeshift --list >/dev/null 2>&1 || die "Timeshift não reconheceu a configuração Btrfs; não foi criado snapshot."
if ! timeshift --list 2>/dev/null | grep -q 'timeshift-btrfs'; then
  timeshift --create --comments "Forja OS: snapshot inicial" --tags B --scripted || die "Falha ao criar o snapshot inicial."
fi

[[ -x "$GRUB_MKCONFIG" && -d /boot/grub ]] || die "GRUB não está instalado ou /boot/grub não existe."
systemctl enable --now forja-timeshift-check.timer
grub_service="/usr/lib/systemd/system/grub-btrfsd.service"
[[ -s "$grub_service" ]] || die "grub-btrfsd.service não foi encontrado."
systemctl enable --now grub-btrfsd.service
"$GRUB_MKCONFIG" -o /boot/grub/grub.cfg
timeshift --list >/dev/null || die "A listagem final do Timeshift falhou."
log "Timeshift Btrfs configurado; timer, GRUB-Btrfs e snapshot inicial verificados."
