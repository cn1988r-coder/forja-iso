#!/usr/bin/env bash
set -Eeuo pipefail

action="${1:-pre}"
[[ "$action" == "pre" ]] || exit 2
[[ "$(findmnt -n -o FSTYPE / 2>/dev/null || true)" == "btrfs" ]] || exit 0
[[ -s /etc/timeshift/timeshift.json ]] || exit 0
command -v timeshift >/dev/null 2>&1 || exit 0

exec /usr/bin/timeshift --create --comments "Forja OS: antes de atualizar pacotes" --tags O --scripted
