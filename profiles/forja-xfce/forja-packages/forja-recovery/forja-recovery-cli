#!/usr/bin/env python3
"""Forja Recovery: diagnostico do sistema e integracao com Timeshift."""
from __future__ import annotations
import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

def run(args: list[str]) -> tuple[int, str]:
    try:
        p = subprocess.run(args, text=True, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, check=False, timeout=45)
        return p.returncode, p.stdout.strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, str(exc)

def check(label: str, ok: bool, detail: str) -> dict:
    return {"item": label, "status": "ok" if ok else "attention", "detail": detail}

def diagnose() -> list[dict]:
    results = []
    rc, out = run(["findmnt", "-n", "-o", "FSTYPE", "/"])
    is_btrfs = rc == 0 and out.strip() == "btrfs"
    results.append(check("Sistema de arquivos raiz", is_btrfs,
                         out or "Não foi possível identificar o sistema de arquivos."))
    rc, out = run(["timeshift", "--list"])
    results.append(check("Timeshift", rc == 0,
                         out if rc == 0 else (out or "Timeshift não está configurado ou não reconheceu o volume.")))
    for unit in ("forja-timeshift-check.timer", "grub-btrfsd.service"):
        unit_rc, unit_out = run(["systemctl", "is-enabled", unit])
        results.append(check(unit, unit_rc == 0, unit_out or "Unidade não habilitada."))
    rc, out = run(["pacman", "-D", "k"])
    results.append(check("Base de dados do Pacman", rc == 0,
                         out or ("Verificação concluída." if rc == 0 else "Pacman retornou erro.")))
    grub_cfg = Path("/boot/grub/grub.cfg")
    results.append(check("Configuração do GRUB", grub_cfg.is_file(),
                         str(grub_cfg) if grub_cfg.is_file() else "Arquivo /boot/grub/grub.cfg não encontrado."))
    kernels = sorted(Path("/boot").glob("vmlinuz-*")) if Path("/boot").exists() else []
    results.append(check("Kernel instalado", bool(kernels),
                         ", ".join(p.name for p in kernels) if kernels else "Nenhum kernel encontrado em /boot."))
    results.append(check("Ferramentas Btrfs", shutil.which("btrfs") is not None,
                         shutil.which("btrfs") or "Comando btrfs não encontrado."))
    results.append(check("Integração GRUB-Btrfs", shutil.which("grub-btrfsd") is not None,
                         shutil.which("grub-btrfsd") or "grub-btrfsd não encontrado."))
    config = Path("/etc/timeshift/timeshift.json")
    results.append(check("Configuração Timeshift", config.is_file(),
                         str(config) if config.is_file() else "Configuração Timeshift ausente."))
    return results

def snapshots() -> tuple[int, str]:
    return run(["timeshift", "--list"])

def create_snapshot(description: str) -> tuple[int, str]:
    if not description.strip() or len(description) > 120:
        return 2, "Descrição inválida (1 a 120 caracteres)."
    rc, fs = run(["findmnt", "-n", "-o", "FSTYPE", "/"])
    if rc or fs.strip() != "btrfs":
        return 3, "A raiz não está em Btrfs. Nenhum snapshot foi criado."
    return run(["pkexec", "timeshift", "--create", "--comments", description,
                "--tags", "O", "--scripted"])

def open_timeshift() -> tuple[int, str]:
    executable = shutil.which("timeshift-gtk")
    if not executable:
        return 127, "Interface gráfica do Timeshift não encontrada."
    try:
        subprocess.Popen([executable], start_new_session=True)
        return 0, "Timeshift aberto. Escolha o snapshot e use Restaurar; confira cuidadosamente o dispositivo e a raiz."
    except OSError as exc:
        return 127, str(exc)

def main() -> int:
    parser = argparse.ArgumentParser(description="Diagnóstico e recuperação do Forja OS")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("diagnose", help="Executa verificações somente de leitura")
    sub.add_parser("snapshots", help="Lista snapshots do Timeshift")
    create = sub.add_parser("create-snapshot", help="Cria snapshot manual com Timeshift")
    create.add_argument("--description", required=True)
    sub.add_parser("open-timeshift", help="Abre a interface oficial de restauração do Timeshift")
    args = parser.parse_args()
    if args.command == "diagnose":
        data = diagnose()
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return 0 if all(x["status"] == "ok" for x in data) else 1
    if args.command == "snapshots":
        rc, out = snapshots()
    elif args.command == "create-snapshot":
        rc, out = create_snapshot(args.description)
    else:
        rc, out = open_timeshift()
    print(out or ("Operação concluída." if rc == 0 else "A operação falhou."))
    return rc

if __name__ == "__main__":
    sys.exit(main())
