#!/usr/bin/env python3
"""Interface GTK simples do Forja Recovery."""
import json
import subprocess
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib

CLI = "/usr/bin/forja-recovery-cli"

class RecoveryWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Forja Recovery")
        self.set_default_size(760, 520)
        self.set_border_width(16)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(root)
        title = Gtk.Label()
        title.set_markup("<span size='xx-large' weight='bold'>Forja Recovery</span>\nDiagnóstico e recuperação do sistema")
        title.set_xalign(0)
        root.pack_start(title, False, False, 0)
        actions = Gtk.Box(spacing=8)
        root.pack_start(actions, False, False, 0)
        for label, callback in (("Executar diagnóstico", self.diagnose),
                                ("Listar snapshots", self.list_snapshots),
                                ("Criar snapshot", self.create_snapshot)):
            button = Gtk.Button(label=label)
            button.connect("clicked", callback)
            actions.pack_start(button, False, False, 0)
        self.output = Gtk.TextView()
        self.output.set_editable(False)
        self.output.set_cursor_visible(False)
        self.output.get_buffer().set_text("Execute um diagnóstico para verificar o estado do sistema.\n\nAs verificações são somente de leitura. A criação de snapshot exige confirmação e privilégios administrativos.")
        scroll = Gtk.ScrolledWindow()
        scroll.set_hexpand(True)
        scroll.set_vexpand(True)
        scroll.add(self.output)
        root.pack_start(scroll, True, True, 0)

    def show_text(self, text):
        self.output.get_buffer().set_text(text)

    def execute(self, args):
        try:
            p = subprocess.run(args, text=True, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, timeout=45, check=False)
            self.show_text(p.stdout or ("Concluído." if p.returncode == 0 else "Falha na operação."))
        except Exception as exc:
            self.show_text(f"Não foi possível executar: {exc}")

    def diagnose(self, *_):
        try:
            p = subprocess.run([CLI, "diagnose"], text=True, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, timeout=45, check=False)
            data = json.loads(p.stdout)
            lines = []
            for item in data:
                symbol = "OK" if item["status"] == "ok" else "ATENÇÃO"
                lines.append(f"[{symbol}] {item['item']}\n{item['detail']}\n")
            self.show_text("\n".join(lines))
        except Exception as exc:
            self.show_text(f"Falha no diagnóstico: {exc}")

    def list_snapshots(self, *_):
        self.execute([CLI, "snapshots"])

    def create_snapshot(self, *_):
        dialog = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.OK_CANCEL,
                                   text="Criar um snapshot manual da raiz?")
        dialog.format_secondary_text("O Snapper precisa estar configurado e a raiz precisa usar Btrfs. Esta ação não altera /home.")
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        entry_dialog = Gtk.Dialog(title="Descrição do snapshot", transient_for=self, flags=0)
        entry_dialog.add_button("Cancelar", Gtk.ResponseType.CANCEL)
        entry_dialog.add_button("Criar", Gtk.ResponseType.OK)
        entry = Gtk.Entry()
        entry.set_text("Snapshot manual Forja Recovery")
        entry_dialog.get_content_area().pack_start(entry, True, True, 12)
        entry_dialog.show_all()
        response = entry_dialog.run()
        description = entry.get_text().strip()
        entry_dialog.destroy()
        if response == Gtk.ResponseType.OK and description:
            self.execute(["pkexec", CLI, "create-snapshot", "--description", description])

win = RecoveryWindow()
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
