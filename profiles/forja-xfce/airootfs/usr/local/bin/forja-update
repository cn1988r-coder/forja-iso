#!/usr/bin/env python3
"""Safe, manifest-driven updater for Forja XFCE components."""
from __future__ import annotations
import hashlib, json, os, shutil, sys, tempfile, urllib.request
from urllib.parse import urlparse
from datetime import datetime, timezone
from pathlib import Path

REPOSITORY = "cn1988r-coder/forja-updates"
MANIFEST_URL = f"https://raw.githubusercontent.com/{REPOSITORY}/main/manifests/stable.json"
ASSET_PREFIX = f"https://github.com/{REPOSITORY}/releases/download/"
STATE_ROOT = Path("/var/lib/forja-update")
ALLOWED = ("/usr/local/bin/forja-", "/usr/local/lib/forja/", "/usr/share/forja/", "/usr/share/applications/forja-", "/etc/skel/.config/forja/")

def fail(message: str, code: int = 1) -> None:
    print(f"Forja Update: {message}", file=sys.stderr)
    raise SystemExit(code)

def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def allowed_target(raw: str) -> Path:
    if not isinstance(raw, str) or not raw.startswith("/") or ".." in Path(raw).parts:
        fail(f"caminho de destino inválido: {raw!r}")
    if not any(raw.startswith(prefix) for prefix in ALLOWED):
        fail(f"destino fora dos diretórios permitidos: {raw}")
    target = Path(raw)
    resolved = target.parent.resolve(strict=False) / target.name
    if not any(str(resolved).startswith(prefix) for prefix in ALLOWED):
        fail(f"destino resolvido fora da lista permitida: {raw}")
    for parent in (target, *target.parents):
        if parent.is_symlink():
            fail(f"links simbólicos não são permitidos no caminho: {raw}")
    return target

def fetch(url: str, destination: Path) -> None:
    request = urllib.request.Request(url, headers={"User-Agent": "Forja-Update/1"})
    with urllib.request.urlopen(request, timeout=30) as response, destination.open("wb") as out:
        final_url = response.geturl()
        parsed = urlparse(final_url)
        if url.startswith(ASSET_PREFIX):
            trusted = parsed.scheme == "https" and parsed.hostname in ("github.com", "release-assets.githubusercontent.com")
        else:
            trusted = final_url.startswith("https://raw.githubusercontent.com/" + REPOSITORY + "/")
        if not trusted:
            fail("redirecionamento de download não confiável.")
        shutil.copyfileobj(response, out)

def rollback() -> None:
    backups = sorted(STATE_ROOT.glob("backups/*/state.json"))
    if not backups:
        fail("nenhum backup disponível para rollback.", 0)
    state_file = backups[-1]
    state = json.loads(state_file.read_text(encoding="utf-8"))
    for item in reversed(state["files"]):
        target = Path(item["target"])
        backup = state_file.parent / item["backup"] if item["backup"] else None
        if backup and backup.exists():
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(backup, target)
        else:
            target.unlink(missing_ok=True)
    print(f"Rollback concluído: {state_file.parent.name}")

def main() -> None:
    if os.geteuid() != 0:
        fail("execute com privilégios administrativos: sudo forja-update")
    if sys.argv[1:] == ["--rollback"]:
        rollback()
        return
    if sys.argv[1:]:
        fail("uso: forja-update [--rollback]")
    with tempfile.TemporaryDirectory(prefix="forja-update-") as temp:
        work = Path(temp)
        manifest_path = work / "stable.json"
        try:
            fetch(MANIFEST_URL, manifest_path)
        except Exception as exc:
            fail(f"não foi possível consultar Forja Updates ({exc}). O pacman e os repositórios oficiais não são afetados.")
        try:
            manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        except Exception as exc:
            fail(f"manifesto JSON inválido: {exc}")
        if manifest.get("schema_version") != 1 or manifest.get("channel") != "stable":
            fail("versão de esquema ou canal do manifesto não suportado.")
        artifacts = manifest.get("artifacts")
        if not isinstance(artifacts, list):
            fail("campo artifacts inválido.")
        pending = []
        for index, item in enumerate(artifacts):
            if not isinstance(item, dict) or item.get("edition") not in ("all", "xfce"):
                continue
            name, url, checksum = item.get("name"), item.get("url"), item.get("sha256")
            if not isinstance(name, str) or not name or not isinstance(checksum, str) or len(checksum) != 64 or any(c not in "0123456789abcdef" for c in checksum.lower()):
                fail(f"metadados ou SHA-256 inválidos no artefato {index}.")
            if not isinstance(url, str) or not url.startswith(ASSET_PREFIX):
                fail(f"URL não permitida no artefato {name}.")
            target = allowed_target(item.get("target"))
            mode = item.get("mode", "0644")
            if not isinstance(mode, str) or len(mode) != 4 or any(c not in "01234567" for c in mode):
                fail(f"permissão inválida no artefato {name}.")
            download = work / f"artifact-{index}"
            try:
                fetch(url, download)
            except Exception as exc:
                fail(f"falha ao baixar {name}: {exc}")
            if digest(download) != checksum.lower():
                fail(f"SHA-256 não confere para {name}; nenhum arquivo foi instalado.")
            if target.exists() and target.is_file() and digest(target) == checksum.lower():
                continue
            pending.append((name, target, download, int(mode, 8)))
        if not pending:
            print("Forja XFCE já está atualizada. Nenhum artefato novo no canal estável.")
            return
        print("Atualizações disponíveis:")
        for name, target, _, _ in pending:
            print(f"  - {name} -> {target}")
        if input("Aplicar as atualizações? [s/N] ").strip().lower() not in ("s", "sim"):
            print("Operação cancelada.")
            return
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        backup_dir = STATE_ROOT / "backups" / stamp
        backup_dir.mkdir(parents=True, exist_ok=False)
        records, applied = [], []
        try:
            for index, (name, target, download, mode) in enumerate(pending):
                target.parent.mkdir(parents=True, exist_ok=True)
                backup_name = None
                if target.exists():
                    if not target.is_file() or target.is_symlink():
                        fail(f"destino existente não é arquivo regular: {target}")
                    backup_name = f"{index}.bak"
                    shutil.copy2(target, backup_dir / backup_name)
                record = {"target": str(target), "backup": backup_name}
                records.append(record)
                fd, temp_name = tempfile.mkstemp(prefix=".forja-update-", dir=target.parent)
                os.close(fd)
                try:
                    shutil.copyfile(download, temp_name)
                    os.chmod(temp_name, mode)
                    os.replace(temp_name, target)
                finally:
                    Path(temp_name).unlink(missing_ok=True)
                applied.append(record)
            (backup_dir / "state.json").write_text(json.dumps({"files": records}, indent=2), encoding="utf-8")
        except BaseException:
            for item in reversed(applied):
                target = Path(item["target"])
                backup = backup_dir / item["backup"] if item["backup"] else None
                if backup and backup.exists():
                    shutil.copy2(backup, target)
                else:
                    target.unlink(missing_ok=True)
            raise
        print("Atualização aplicada. Para reverter: sudo forja-update --rollback")

if __name__ == "__main__":
    main()
