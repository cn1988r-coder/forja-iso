#!/usr/bin/env bash
set -Eeuo pipefail

REPOSITORY="cn1988r-coder/forja-iso"
API_URL="https://api.github.com/repos/${REPOSITORY}/releases/latest"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

if [[ "${EUID}" -ne 0 ]]; then
  echo "Execute com privilégios administrativos: sudo forja-update" >&2
  exit 1
fi

for command in curl jq pacman pacman-conf; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "Dependência ausente: $command" >&2
    exit 1
  }
done

# Fail closed: local package signatures must be mandatory before installing
# anything downloaded from a GitHub release.
LOCAL_SIGLEVEL="$(pacman-conf LocalFileSigLevel 2>/dev/null || true)"
if [[ ! "$LOCAL_SIGLEVEL" =~ (^|[[:space:]])(Package)?Required($|[[:space:]]) ]]; then
  echo "Atualização cancelada: LocalFileSigLevel não exige assinaturas." >&2
  echo "Configure e valide a chave oficial de assinatura da Forja antes de usar este atualizador." >&2
  exit 1
fi

echo "Consultando a última versão estável da Forja..."
curl --fail --silent --show-error --location \
  --header "Accept: application/vnd.github+json" \
  --header "X-GitHub-Api-Version: 2022-11-28" \
  "$API_URL" -o "$TMP_DIR/release.json"

TAG="$(jq -r '.tag_name // empty' "$TMP_DIR/release.json")"
[[ -n "$TAG" ]] || {
  echo "Nenhuma versão estável publicada para a Forja." >&2
  exit 1
}

mapfile -t PACKAGE_ASSETS < <(
  jq -r '.assets[]?
    | select(.name | startswith("forja-") and endswith(".pkg.tar.zst"))
    | [.name, .browser_download_url] | @tsv' "$TMP_DIR/release.json"
)

if (( ${#PACKAGE_ASSETS[@]} == 0 )); then
  echo "A versão $TAG não contém pacotes Forja para instalar."
  exit 0
fi

for entry in "${PACKAGE_ASSETS[@]}"; do
  IFS=$'\t' read -r name url <<< "$entry"
  [[ -n "$name" && -n "$url" ]] || {
    echo "Metadados de pacote inválidos na versão $TAG." >&2
    exit 1
  }
  signature_url="$(jq -r --arg name "${name}.sig" '.assets[]? | select(.name == $name) | .browser_download_url' "$TMP_DIR/release.json")"
  [[ -n "$signature_url" && "$signature_url" != "null" ]] || {
    echo "Assinatura ausente para $name. Nenhum pacote será instalado." >&2
    exit 1
  }

  curl --fail --silent --show-error --location "$url" -o "$TMP_DIR/$name"
  curl --fail --silent --show-error --location "$signature_url" -o "$TMP_DIR/$name.sig"
done

echo "Pacotes da versão $TAG baixados. O Pacman validará as assinaturas antes da instalação."
pacman -U --needed -- "$TMP_DIR"/*.pkg.tar.zst
