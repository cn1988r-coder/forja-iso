#!/usr/bin/python3
"""Graphical, polkit-authenticated entry point for the Forja OS installer."""
import os
import shutil
import subprocess
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

def main():
    if shutil.which("calamares") and shutil.which("pkexec"):
        command = ["/usr/bin/calamares"] if os.geteuid() == 0 else ["/usr/bin/pkexec", "/usr/bin/calamares"]
        return subprocess.call(command)
    dialog = Gtk.MessageDialog(
        message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.CLOSE,
        text="O instalador gráfico da Forja OS não está disponível.",
    )
    dialog.format_secondary_text(
        "O Calamares ou o serviço de autenticação Polkit não foi encontrado nesta ISO. "
        "Nenhum terminal será aberto e nenhuma instalação será iniciada."
    )
    dialog.run()
    dialog.destroy()
    return 1

if __name__ == "__main__":
    raise SystemExit(main())
