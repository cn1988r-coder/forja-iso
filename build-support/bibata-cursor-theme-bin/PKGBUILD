pkgname=bibata-cursor-theme-bin
pkgver=2.0.7
pkgrel=1
pkgdesc="Bibata Modern Classic cursor theme"
arch=('any')
url="https://github.com/ful1e5/Bibata_Cursor"
license=('GPL-3.0-or-later')
source=("${pkgname}-${pkgver}.tar.xz::${url}/releases/download/v${pkgver}/Bibata-Modern-Classic.tar.xz")
sha256sums=('SKIP')
options=('!strip')

package() {
  install -dm755 "${pkgdir}/usr/share/icons"
  cp -dr --no-preserve=mode Bibata-Modern-Classic "${pkgdir}/usr/share/icons/"
}
